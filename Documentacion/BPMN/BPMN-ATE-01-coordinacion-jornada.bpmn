<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CoordinacionJornada" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_CoordinacionJornada"><bpmn:participant id="Participant_CoordinacionJornada" name="Barrio Solidario - Coordinación de la jornada" processRef="Process_CoordinacionJornada" /></bpmn:collaboration>
 <bpmn:process id="Process_CoordinacionJornada" name="Coordinación de la jornada de atención" isExecutable="false">
  <bpmn:laneSet id="LaneSet_CoordinacionJornada">
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación"><bpmn:flowNodeRef>Start_SolicitudAsignada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarNecesidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DefinirPropuesta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AjustarPropuesta</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Continuar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarCondiciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Condiciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ResolverNovedad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AutorizarJornada</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario"><bpmn:flowNodeRef>Task_ConsultarDisponibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarPropuesta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsolidarRespuestas</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AmbosConfirman</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProgramarJornada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_HabilitarDatos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReprogramarEstado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CancelarCoordinacion</bpmn:flowNodeRef><bpmn:flowNodeRef>End_JornadaProgramada</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CoordinacionCancelada</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Voluntario" name="Voluntario"><bpmn:flowNodeRef>Task_ResponderVoluntario</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsultarInstrucciones</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado"><bpmn:flowNodeRef>Task_ResponderSolicitante</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarAcompanamiento</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría"><bpmn:flowNodeRef>Task_EnviarPropuesta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarProgramacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProgramarRecordatorios</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarReprogramacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarCancelacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_SolicitudAsignada" name="Solicitud con voluntario asignado" />
  <bpmn:userTask id="Task_RevisarNecesidad" name="Revisar necesidad, prioridad y condiciones especiales" />
  <bpmn:serviceTask id="Task_ConsultarDisponibilidad" name="Consultar disponibilidad declarada de las partes" />
  <bpmn:userTask id="Task_DefinirPropuesta" name="Definir fecha, hora, duración, lugar y punto de encuentro" />
  <bpmn:serviceTask id="Task_RegistrarPropuesta" name="Registrar propuesta de jornada" />
  <bpmn:sendTask id="Task_EnviarPropuesta" name="Enviar propuesta al voluntario y solicitante" />
  <bpmn:userTask id="Task_ResponderVoluntario" name="Confirmar disponibilidad o proponer ajuste" />
  <bpmn:userTask id="Task_ResponderSolicitante" name="Confirmar disponibilidad, acompañamiento o proponer ajuste" />
  <bpmn:serviceTask id="Task_ConsolidarRespuestas" name="Consolidar respuestas y restricciones" />
  <bpmn:exclusiveGateway id="Gateway_AmbosConfirman" name="¿Ambas partes confirman?" />
  <bpmn:userTask id="Task_AjustarPropuesta" name="Revisar alternativas y ajustar la jornada" />
  <bpmn:exclusiveGateway id="Gateway_Continuar" name="¿Es posible reprogramar?" />
  <bpmn:serviceTask id="Task_ReprogramarEstado" name="Guardar nueva propuesta y mantener coordinación" />
  <bpmn:serviceTask id="Task_CancelarCoordinacion" name="Cancelar coordinación y devolver solicitud a revisión" />
  <bpmn:sendTask id="Task_NotificarReprogramacion" name="Notificar nueva propuesta a las partes" />
  <bpmn:sendTask id="Task_NotificarCancelacion" name="Notificar cancelación de la coordinación" />
  <bpmn:endEvent id="End_CoordinacionCancelada" name="Coordinación cancelada" />
  <bpmn:serviceTask id="Task_ProgramarJornada" name="Programar jornada y cambiar estado a Coordinada" />
  <bpmn:serviceTask id="Task_HabilitarDatos" name="Habilitar datos mínimos de contacto y ubicación" />
  <bpmn:userTask id="Task_ConfirmarAcompanamiento" name="Confirmar acompañante o apoyo del cuidador cuando aplique" />
  <bpmn:userTask id="Task_ValidarCondiciones" name="Verificar transporte, accesibilidad, seguridad y recursos" />
  <bpmn:exclusiveGateway id="Gateway_Condiciones" name="¿Condiciones listas?" />
  <bpmn:userTask id="Task_ResolverNovedad" name="Resolver novedad o ajustar condiciones" />
  <bpmn:userTask id="Task_AutorizarJornada" name="Autorizar ejecución de la jornada" />
  <bpmn:sendTask id="Task_NotificarProgramacion" name="Notificar programación confirmada" />
  <bpmn:serviceTask id="Task_ProgramarRecordatorios" name="Programar recordatorios y canal de comunicación" />
  <bpmn:userTask id="Task_ConsultarInstrucciones" name="Consultar instrucciones y datos autorizados" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar acuerdos, cambios, confirmaciones y responsable" />
  <bpmn:endEvent id="End_JornadaProgramada" name="Jornada coordinada" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_SolicitudAsignada" targetRef="Task_RevisarNecesidad" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RevisarNecesidad" targetRef="Task_ConsultarDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConsultarDisponibilidad" targetRef="Task_DefinirPropuesta" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_DefinirPropuesta" targetRef="Task_RegistrarPropuesta" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RegistrarPropuesta" targetRef="Task_EnviarPropuesta" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_EnviarPropuesta" targetRef="Task_ResponderVoluntario" />
  <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ResponderVoluntario" targetRef="Task_ResponderSolicitante" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ResponderSolicitante" targetRef="Task_ConsolidarRespuestas" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ConsolidarRespuestas" targetRef="Gateway_AmbosConfirman" />
  <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_AmbosConfirman" targetRef="Task_AjustarPropuesta" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AjustarPropuesta" targetRef="Gateway_Continuar" />
  <bpmn:sequenceFlow id="Flow_12" name="Sí" sourceRef="Gateway_Continuar" targetRef="Task_ReprogramarEstado" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ReprogramarEstado" targetRef="Task_NotificarReprogramacion" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_NotificarReprogramacion" targetRef="Task_EnviarPropuesta" />
  <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_Continuar" targetRef="Task_CancelarCoordinacion" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CancelarCoordinacion" targetRef="Task_NotificarCancelacion" />
  <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotificarCancelacion" targetRef="End_CoordinacionCancelada" />
  <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="Gateway_AmbosConfirman" targetRef="Task_ProgramarJornada" />
  <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ProgramarJornada" targetRef="Task_HabilitarDatos" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_HabilitarDatos" targetRef="Task_ConfirmarAcompanamiento" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ConfirmarAcompanamiento" targetRef="Task_ValidarCondiciones" />
  <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ValidarCondiciones" targetRef="Gateway_Condiciones" />
  <bpmn:sequenceFlow id="Flow_23" name="No" sourceRef="Gateway_Condiciones" targetRef="Task_ResolverNovedad" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ResolverNovedad" targetRef="Task_AjustarPropuesta" />
  <bpmn:sequenceFlow id="Flow_25" name="Sí" sourceRef="Gateway_Condiciones" targetRef="Task_AutorizarJornada" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_AutorizarJornada" targetRef="Task_NotificarProgramacion" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_NotificarProgramacion" targetRef="Task_ProgramarRecordatorios" />
  <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_ProgramarRecordatorios" targetRef="Task_ConsultarInstrucciones" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ConsultarInstrucciones" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_JornadaProgramada" />

  <bpmn:textAnnotation id="Annotation_Coordinacion"><bpmn:text>La jornada debe considerar las limitaciones de movilidad, accesibilidad o uso tecnológico del adulto mayor. Cuando corresponda, el cuidador o familiar autorizado confirma el acompañamiento. La ubicación exacta y el contacto se habilitan sólo al voluntario confirmado.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Coordinacion" sourceRef="Task_DefinirPropuesta" targetRef="Annotation_Coordinacion" />
 </bpmn:process>

