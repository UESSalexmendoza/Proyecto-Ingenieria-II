<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EjecucionSeguimiento" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_EjecucionSeguimiento"><bpmn:participant id="Participant_EjecucionSeguimiento" name="Barrio Solidario - Ejecución y seguimiento de la atención" processRef="Process_EjecucionSeguimiento" /></bpmn:collaboration>
 <bpmn:process id="Process_EjecucionSeguimiento" name="Ejecución y seguimiento de una atención comunitaria" isExecutable="false">
  <bpmn:laneSet id="LaneSet_EjecucionSeguimiento">
   <bpmn:lane id="Lane_Voluntario" name="Voluntario"><bpmn:flowNodeRef>Start_JornadaProgramada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarAsistencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PuedeAsistir</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReportarImposibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_IniciarDesplazamiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarLlegada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_IniciarAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EjecutarApoyo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarAvance</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarResultado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SolicitarCierre</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario"><bpmn:flowNodeRef>Task_ActualizarEnCamino</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarEnAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AtencionCompletada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarPendienteCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarInterrumpida</bpmn:flowNodeRef><bpmn:flowNodeRef>End_PendienteCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Interrumpida</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado"><bpmn:flowNodeRef>Task_ConfirmarLlegada</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_InicioSeguro</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AtencionRecibida</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarObservacion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación / Moderación"><bpmn:flowNodeRef>Task_GestionarAusencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MonitorearAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ExisteIncidencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GestionarIncidencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PuedeContinuar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarObservacion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría"><bpmn:flowNodeRef>Task_EnviarRecordatorio</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarIncidencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarInterrupcion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarSolicitudCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_JornadaProgramada" name="Jornada programada próxima a iniciar" />
  <bpmn:sendTask id="Task_EnviarRecordatorio" name="Enviar recordatorio y recomendaciones de seguridad" />
  <bpmn:userTask id="Task_ConfirmarAsistencia" name="Confirmar disponibilidad final" />
  <bpmn:exclusiveGateway id="Gateway_PuedeAsistir" name="¿Puede asistir?" />
  <bpmn:userTask id="Task_ReportarImposibilidad" name="Reportar imposibilidad y motivo" />
  <bpmn:userTask id="Task_GestionarAusencia" name="Evaluar reemplazo, reprogramación o cancelación" />
  <bpmn:serviceTask id="Task_ActualizarInterrumpida" name="Actualizar estado a Reprogramación o Cancelada" />
  <bpmn:sendTask id="Task_NotificarInterrupcion" name="Notificar cambio a las partes" />
  <bpmn:endEvent id="End_Interrumpida" name="Atención reprogramada o cancelada" />
  <bpmn:userTask id="Task_IniciarDesplazamiento" name="Iniciar desplazamiento hacia el punto acordado" />
  <bpmn:serviceTask id="Task_ActualizarEnCamino" name="Cambiar estado a En camino" />
  <bpmn:userTask id="Task_RegistrarLlegada" name="Registrar llegada al punto acordado" />
  <bpmn:userTask id="Task_ConfirmarLlegada" name="Confirmar identidad y llegada del voluntario" />
  <bpmn:exclusiveGateway id="Gateway_InicioSeguro" name="¿Condiciones seguras para iniciar?" />
  <bpmn:serviceTask id="Task_RegistrarIncidencia" name="Registrar incidencia, ubicación aproximada y prioridad" />
  <bpmn:userTask id="Task_GestionarIncidencia" name="Contactar a las partes y gestionar la incidencia" />
  <bpmn:exclusiveGateway id="Gateway_PuedeContinuar" name="¿Puede continuar la atención?" />
  <bpmn:userTask id="Task_IniciarAtencion" name="Confirmar inicio de la atención" />
  <bpmn:serviceTask id="Task_ActualizarEnAtencion" name="Cambiar estado a En atención" />
  <bpmn:userTask id="Task_EjecutarApoyo" name="Ejecutar la asistencia acordada" />
  <bpmn:userTask id="Task_RegistrarAvance" name="Registrar avance, hora y resultado parcial" />
  <bpmn:userTask id="Task_MonitorearAtencion" name="Revisar avance, tiempo y alertas" />
  <bpmn:exclusiveGateway id="Gateway_ExisteIncidencia" name="¿Existe incidencia o desviación?" />
  <bpmn:exclusiveGateway id="Gateway_AtencionCompletada" name="¿Atención completada?" />
  <bpmn:userTask id="Task_RegistrarResultado" name="Registrar resultado final y observaciones" />
  <bpmn:userTask id="Task_SolicitarCierre" name="Solicitar cierre de la atención" />
  <bpmn:sendTask id="Task_NotificarSolicitudCierre" name="Notificar solicitud de cierre al solicitante" />
  <bpmn:userTask id="Task_ConfirmarAtencion" name="Confirmar atención recibida o reportar observación" />
  <bpmn:exclusiveGateway id="Gateway_AtencionRecibida" name="¿Atención confirmada?" />
  <bpmn:userTask id="Task_RegistrarObservacion" name="Registrar desacuerdo o actividad pendiente" />
  <bpmn:userTask id="Task_RevisarObservacion" name="Validar observación y definir acción correctiva" />
  <bpmn:serviceTask id="Task_ActualizarPendienteCierre" name="Cambiar estado a Pendiente de aprobación de cierre" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar avances, evidencias permitidas, decisiones y responsables" />
  <bpmn:endEvent id="End_PendienteCierre" name="Atención ejecutada y cierre solicitado" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_JornadaProgramada" targetRef="Task_EnviarRecordatorio" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_EnviarRecordatorio" targetRef="Task_ConfirmarAsistencia" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConfirmarAsistencia" targetRef="Gateway_PuedeAsistir" />
  <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_PuedeAsistir" targetRef="Task_ReportarImposibilidad" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ReportarImposibilidad" targetRef="Task_GestionarAusencia" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GestionarAusencia" targetRef="Task_ActualizarInterrumpida" />
  <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ActualizarInterrumpida" targetRef="Task_NotificarInterrupcion" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_NotificarInterrupcion" targetRef="End_Interrumpida" />
  <bpmn:sequenceFlow id="Flow_09" name="Sí" sourceRef="Gateway_PuedeAsistir" targetRef="Task_IniciarDesplazamiento" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_IniciarDesplazamiento" targetRef="Task_ActualizarEnCamino" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ActualizarEnCamino" targetRef="Task_RegistrarLlegada" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RegistrarLlegada" targetRef="Task_ConfirmarLlegada" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConfirmarLlegada" targetRef="Gateway_InicioSeguro" />
  <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_InicioSeguro" targetRef="Task_RegistrarIncidencia" />
  <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RegistrarIncidencia" targetRef="Task_GestionarIncidencia" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_GestionarIncidencia" targetRef="Gateway_PuedeContinuar" />
  <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="Gateway_PuedeContinuar" targetRef="Task_ActualizarInterrumpida" />
  <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="Gateway_PuedeContinuar" targetRef="Task_IniciarAtencion" />
  <bpmn:sequenceFlow id="Flow_19" name="Sí" sourceRef="Gateway_InicioSeguro" targetRef="Task_IniciarAtencion" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_IniciarAtencion" targetRef="Task_ActualizarEnAtencion" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ActualizarEnAtencion" targetRef="Task_EjecutarApoyo" />
  <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_EjecutarApoyo" targetRef="Task_RegistrarAvance" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_RegistrarAvance" targetRef="Task_MonitorearAtencion" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_MonitorearAtencion" targetRef="Gateway_ExisteIncidencia" />
  <bpmn:sequenceFlow id="Flow_25" name="Sí" sourceRef="Gateway_ExisteIncidencia" targetRef="Task_RegistrarIncidencia" />
  <bpmn:sequenceFlow id="Flow_26" name="No" sourceRef="Gateway_ExisteIncidencia" targetRef="Gateway_AtencionCompletada" />
  <bpmn:sequenceFlow id="Flow_27" name="No" sourceRef="Gateway_AtencionCompletada" targetRef="Task_EjecutarApoyo" />
  <bpmn:sequenceFlow id="Flow_28" name="Sí" sourceRef="Gateway_AtencionCompletada" targetRef="Task_RegistrarResultado" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RegistrarResultado" targetRef="Task_SolicitarCierre" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_SolicitarCierre" targetRef="Task_NotificarSolicitudCierre" />
  <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_NotificarSolicitudCierre" targetRef="Task_ConfirmarAtencion" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ConfirmarAtencion" targetRef="Gateway_AtencionRecibida" />
  <bpmn:sequenceFlow id="Flow_33" name="No" sourceRef="Gateway_AtencionRecibida" targetRef="Task_RegistrarObservacion" />
  <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_RegistrarObservacion" targetRef="Task_RevisarObservacion" />
  <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_RevisarObservacion" targetRef="Task_EjecutarApoyo" />
  <bpmn:sequenceFlow id="Flow_36" name="Sí" sourceRef="Gateway_AtencionRecibida" targetRef="Task_ActualizarPendienteCierre" />
  <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_ActualizarPendienteCierre" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_PendienteCierre" />

  <bpmn:textAnnotation id="Annotation_Seguridad"><bpmn:text>El seguimiento registra hitos y avances, no vigilancia continua. No se deben adjuntar fotografías de documentos, datos médicos ni información personal innecesaria. Ante riesgo para una persona, se detiene la atención y se escala a Coordinación o al canal de emergencia correspondiente.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Seguridad" sourceRef="Task_RegistrarAvance" targetRef="Annotation_Seguridad" />
 </bpmn:process>

