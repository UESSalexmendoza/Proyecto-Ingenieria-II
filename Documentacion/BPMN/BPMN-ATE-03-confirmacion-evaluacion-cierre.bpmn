<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ConfirmacionEvaluacionCierre" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_ConfirmacionEvaluacionCierre"><bpmn:participant id="Participant_ConfirmacionEvaluacionCierre" name="Barrio Solidario - Confirmación, evaluación y cierre" processRef="Process_ConfirmacionEvaluacionCierre" /></bpmn:collaboration>
 <bpmn:process id="Process_ConfirmacionEvaluacionCierre" name="Confirmación, evaluación y cierre de la atención" isExecutable="false">
  <bpmn:laneSet id="LaneSet_ConfirmacionEvaluacionCierre">
   <bpmn:lane id="Lane_Voluntario" name="Voluntario"><bpmn:flowNodeRef>Start_CierreSolicitado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CompletarInforme</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CorregirInforme</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario"><bpmn:flowNodeRef>Task_ValidarInforme</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_InformeCompleto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarPendienteConfirmacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RespuestaPlazo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GuardarEvaluacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReabrirAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CerrarSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevocarAccesos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarMetricas</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Reabierta</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado"><bpmn:flowNodeRef>Task_RevisarCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ConfirmaAtencion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarDesacuerdo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EvaluarAtencion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación / Moderación"><bpmn:flowNodeRef>Task_GestionarSinRespuesta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarDesacuerdo</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RequiereContinuidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarExpediente</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DecisionCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DefinirObservaciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AprobarCierre</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría"><bpmn:flowNodeRef>Task_SolicitarCorreccion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarSolicitante</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EnviarRecordatorio</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarReapertura</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarObservaciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarCierre</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_CierreSolicitado" name="Voluntario solicita cierre" />
  <bpmn:userTask id="Task_CompletarInforme" name="Completar resultado, actividades y observaciones finales" />
  <bpmn:serviceTask id="Task_ValidarInforme" name="Validar campos mínimos y evidencias permitidas" />
  <bpmn:exclusiveGateway id="Gateway_InformeCompleto" name="¿Informe completo?" />
  <bpmn:sendTask id="Task_SolicitarCorreccion" name="Solicitar corrección del informe" />
  <bpmn:userTask id="Task_CorregirInforme" name="Corregir y reenviar informe" />
  <bpmn:serviceTask id="Task_RegistrarPendienteConfirmacion" name="Cambiar estado a Pendiente de confirmación" />
  <bpmn:sendTask id="Task_NotificarSolicitante" name="Solicitar confirmación al adulto mayor o cuidador" />
  <bpmn:exclusiveGateway id="Gateway_RespuestaPlazo" name="¿Responde dentro del plazo?" />
  <bpmn:sendTask id="Task_EnviarRecordatorio" name="Enviar recordatorio y escalar seguimiento" />
  <bpmn:userTask id="Task_GestionarSinRespuesta" name="Contactar al cuidador o validar por canal alternativo" />
  <bpmn:userTask id="Task_RevisarCierre" name="Revisar resumen de la atención recibida" />
  <bpmn:exclusiveGateway id="Gateway_ConfirmaAtencion" name="¿Confirma la atención?" />
  <bpmn:userTask id="Task_RegistrarDesacuerdo" name="Registrar desacuerdo, actividad pendiente o incidencia" />
  <bpmn:userTask id="Task_RevisarDesacuerdo" name="Revisar versiones, avances e incidencia reportada" />
  <bpmn:exclusiveGateway id="Gateway_RequiereContinuidad" name="¿Requiere continuar la atención?" />
  <bpmn:serviceTask id="Task_ReabrirAtencion" name="Reabrir atención y cambiar estado a En seguimiento" />
  <bpmn:sendTask id="Task_NotificarReapertura" name="Notificar reapertura y acción requerida" />
  <bpmn:endEvent id="End_Reabierta" name="Atención reabierta" />
  <bpmn:userTask id="Task_EvaluarAtencion" name="Calificar atención y registrar comentario opcional" />
  <bpmn:serviceTask id="Task_GuardarEvaluacion" name="Guardar evaluación separada de datos sensibles" />
  <bpmn:userTask id="Task_RevisarExpediente" name="Revisar informe, confirmación, evaluación e incidencias" />
  <bpmn:exclusiveGateway id="Gateway_DecisionCierre" name="¿Decisión de cierre?" />
  <bpmn:userTask id="Task_DefinirObservaciones" name="Definir correcciones o soportes requeridos" />
  <bpmn:sendTask id="Task_NotificarObservaciones" name="Notificar observaciones al voluntario" />
  <bpmn:userTask id="Task_AprobarCierre" name="Aprobar cierre de la atención" />
  <bpmn:serviceTask id="Task_CerrarSolicitud" name="Cambiar solicitud a Atendida / Cerrada" />
  <bpmn:serviceTask id="Task_RevocarAccesos" name="Revocar acceso a ubicación y contacto compartidos" />
  <bpmn:serviceTask id="Task_ActualizarMetricas" name="Actualizar métricas y antecedentes del voluntario" />
  <bpmn:sendTask id="Task_NotificarCierre" name="Notificar cierre definitivo a las partes" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar decisión, evaluación, estados, fecha y responsable" />
  <bpmn:endEvent id="End_Cerrada" name="Solicitud cerrada" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_CierreSolicitado" targetRef="Task_CompletarInforme" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CompletarInforme" targetRef="Task_ValidarInforme" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarInforme" targetRef="Gateway_InformeCompleto" />
  <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_InformeCompleto" targetRef="Task_SolicitarCorreccion" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SolicitarCorreccion" targetRef="Task_CorregirInforme" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CorregirInforme" targetRef="Task_ValidarInforme" />
  <bpmn:sequenceFlow id="Flow_07" name="Sí" sourceRef="Gateway_InformeCompleto" targetRef="Task_RegistrarPendienteConfirmacion" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_RegistrarPendienteConfirmacion" targetRef="Task_NotificarSolicitante" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_NotificarSolicitante" targetRef="Gateway_RespuestaPlazo" />
  <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_RespuestaPlazo" targetRef="Task_EnviarRecordatorio" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_EnviarRecordatorio" targetRef="Task_GestionarSinRespuesta" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_GestionarSinRespuesta" targetRef="Task_RevisarCierre" />
  <bpmn:sequenceFlow id="Flow_13" name="Sí" sourceRef="Gateway_RespuestaPlazo" targetRef="Task_RevisarCierre" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RevisarCierre" targetRef="Gateway_ConfirmaAtencion" />
  <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_ConfirmaAtencion" targetRef="Task_RegistrarDesacuerdo" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RegistrarDesacuerdo" targetRef="Task_RevisarDesacuerdo" />
  <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_RevisarDesacuerdo" targetRef="Gateway_RequiereContinuidad" />
  <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="Gateway_RequiereContinuidad" targetRef="Task_ReabrirAtencion" />
  <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ReabrirAtencion" targetRef="Task_NotificarReapertura" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NotificarReapertura" targetRef="End_Reabierta" />
  <bpmn:sequenceFlow id="Flow_21" name="No" sourceRef="Gateway_RequiereContinuidad" targetRef="Task_RevisarExpediente" />
  <bpmn:sequenceFlow id="Flow_22" name="Sí" sourceRef="Gateway_ConfirmaAtencion" targetRef="Task_EvaluarAtencion" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_EvaluarAtencion" targetRef="Task_GuardarEvaluacion" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_GuardarEvaluacion" targetRef="Task_RevisarExpediente" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_RevisarExpediente" targetRef="Gateway_DecisionCierre" />
  <bpmn:sequenceFlow id="Flow_26" name="Observar" sourceRef="Gateway_DecisionCierre" targetRef="Task_DefinirObservaciones" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_DefinirObservaciones" targetRef="Task_NotificarObservaciones" />
  <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_NotificarObservaciones" targetRef="Task_CorregirInforme" />
  <bpmn:sequenceFlow id="Flow_29" name="Reabrir" sourceRef="Gateway_DecisionCierre" targetRef="Task_ReabrirAtencion" />
  <bpmn:sequenceFlow id="Flow_30" name="Aprobar" sourceRef="Gateway_DecisionCierre" targetRef="Task_AprobarCierre" />
  <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_AprobarCierre" targetRef="Task_CerrarSolicitud" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CerrarSolicitud" targetRef="Task_RevocarAccesos" />
  <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_RevocarAccesos" targetRef="Task_ActualizarMetricas" />
  <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ActualizarMetricas" targetRef="Task_NotificarCierre" />
  <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_NotificarCierre" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Cerrada" />

  <bpmn:textAnnotation id="Annotation_Cierre"><bpmn:text>La falta de respuesta del adulto mayor no produce cierre automático: Coordinación debe contactar al cuidador o utilizar un canal alternativo accesible. La evaluación es opcional y no sustituye la confirmación. Al cerrar se revocan los accesos temporales a contacto y ubicación.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Cierre" sourceRef="Task_GestionarSinRespuesta" targetRef="Annotation_Cierre" />
 </bpmn:process>

