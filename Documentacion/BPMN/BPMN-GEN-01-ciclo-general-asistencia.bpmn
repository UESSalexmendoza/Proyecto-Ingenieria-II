<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_BarrioSolidario"
  targetNamespace="https://barriosolidario.org/bpmn">

  <bpmn:collaboration id="Collaboration_BarrioSolidario">
    <bpmn:participant id="Participant_BarrioSolidario" name="Barrio Solidario - Ciclo general de asistencia" processRef="Process_CicloAsistencia" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CicloAsistencia" name="Gestión integral de la asistencia comunitaria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Principal">
      <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador">
        <bpmn:flowNodeRef>Start_Necesidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarEvaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conformidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Plataforma Barrio Solidario">
        <bpmn:flowNodeRef>Task_ValidarRegistrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoCompleta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarPostulacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MantenerPublicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CerrarNotificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinacion" name="Coordinación">
        <bpmn:flowNodeRef>Task_RevisarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultadoRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarAsignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VoluntarioAdecuado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CoordinarJornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Jornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionarIncidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Continuar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AprobarCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Voluntario" name="Voluntario">
        <bpmn:flowNodeRef>Task_ConsultarPostular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EjecutarAtencion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarCierre</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Necesidad" name="Necesidad identificada" />
    <bpmn:userTask id="Task_RegistrarSolicitud" name="Registrar solicitud de asistencia" />
    <bpmn:serviceTask id="Task_ValidarRegistrar" name="Validar y registrar solicitud" />
    <bpmn:exclusiveGateway id="Gateway_InfoCompleta" name="¿Información completa?" />
    <bpmn:userTask id="Task_CorregirSolicitud" name="Corregir información" />
    <bpmn:userTask id="Task_RevisarSolicitud" name="Revisar solicitud" />
    <bpmn:exclusiveGateway id="Gateway_ResultadoRevision" name="¿Resultado de la revisión?" />
    <bpmn:serviceTask id="Task_Publicar" name="Publicar solicitud y notificar" />
    <bpmn:serviceTask id="Task_NotificarRechazo" name="Notificar rechazo" />
    <bpmn:endEvent id="End_Rechazada" name="Solicitud rechazada" />
    <bpmn:userTask id="Task_ConsultarPostular" name="Consultar solicitud y postularse" />
    <bpmn:serviceTask id="Task_RegistrarPostulacion" name="Registrar postulación" />
    <bpmn:userTask id="Task_RevisarAsignar" name="Revisar postulaciones" />
    <bpmn:exclusiveGateway id="Gateway_VoluntarioAdecuado" name="¿Voluntario adecuado?" />
    <bpmn:serviceTask id="Task_MantenerPublicada" name="Mantener solicitud publicada" />
    <bpmn:userTask id="Task_CoordinarJornada" name="Asignar voluntario y coordinar jornada" />
    <bpmn:exclusiveGateway id="Gateway_Jornada" name="¿Estado de la jornada?" />
    <bpmn:endEvent id="End_Cancelada" name="Atención cancelada" />
    <bpmn:userTask id="Task_EjecutarAtencion" name="Ejecutar atención y registrar avances" />
    <bpmn:userTask id="Task_SolicitarCierre" name="Solicitar cierre" />
    <bpmn:userTask id="Task_ConfirmarEvaluar" name="Confirmar atención y evaluar" />
    <bpmn:exclusiveGateway id="Gateway_Conformidad" name="¿Atención conforme?" />
    <bpmn:userTask id="Task_GestionarIncidencia" name="Gestionar observación o incidencia" />
    <bpmn:exclusiveGateway id="Gateway_Continuar" name="¿Puede continuar?" />
    <bpmn:endEvent id="End_Escalada" name="Caso escalado" />
    <bpmn:userTask id="Task_AprobarCierre" name="Revisar y aprobar cierre" />
    <bpmn:serviceTask id="Task_CerrarNotificar" name="Cerrar solicitud y notificar" />
    <bpmn:endEvent id="End_Cerrada" name="Solicitud cerrada" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Necesidad" targetRef="Task_RegistrarSolicitud" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RegistrarSolicitud" targetRef="Task_ValidarRegistrar" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarRegistrar" targetRef="Gateway_InfoCompleta" />
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_InfoCompleta" targetRef="Task_CorregirSolicitud" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CorregirSolicitud" targetRef="Task_ValidarRegistrar" />
    <bpmn:sequenceFlow id="Flow_06" name="Sí" sourceRef="Gateway_InfoCompleta" targetRef="Task_RevisarSolicitud" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_RevisarSolicitud" targetRef="Gateway_ResultadoRevision" />
    <bpmn:sequenceFlow id="Flow_08" name="Aprobada" sourceRef="Gateway_ResultadoRevision" targetRef="Task_Publicar" />
    <bpmn:sequenceFlow id="Flow_09" name="Observada" sourceRef="Gateway_ResultadoRevision" targetRef="Task_CorregirSolicitud" />
    <bpmn:sequenceFlow id="Flow_10" name="Rechazada" sourceRef="Gateway_ResultadoRevision" targetRef="Task_NotificarRechazo" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotificarRechazo" targetRef="End_Rechazada" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Publicar" targetRef="Task_ConsultarPostular" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConsultarPostular" targetRef="Task_RegistrarPostulacion" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RegistrarPostulacion" targetRef="Task_RevisarAsignar" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RevisarAsignar" targetRef="Gateway_VoluntarioAdecuado" />
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gateway_VoluntarioAdecuado" targetRef="Task_MantenerPublicada" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_MantenerPublicada" targetRef="Task_ConsultarPostular" />
    <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="Gateway_VoluntarioAdecuado" targetRef="Task_CoordinarJornada" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CoordinarJornada" targetRef="Gateway_Jornada" />
    <bpmn:sequenceFlow id="Flow_20" name="Reprogramada" sourceRef="Gateway_Jornada" targetRef="Task_CoordinarJornada" />
    <bpmn:sequenceFlow id="Flow_21" name="Cancelada" sourceRef="Gateway_Jornada" targetRef="End_Cancelada" />
    <bpmn:sequenceFlow id="Flow_22" name="Confirmada" sourceRef="Gateway_Jornada" targetRef="Task_EjecutarAtencion" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_EjecutarAtencion" targetRef="Task_SolicitarCierre" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_SolicitarCierre" targetRef="Task_ConfirmarEvaluar" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConfirmarEvaluar" targetRef="Gateway_Conformidad" />
    <bpmn:sequenceFlow id="Flow_26" name="No" sourceRef="Gateway_Conformidad" targetRef="Task_GestionarIncidencia" />
    <bpmn:sequenceFlow id="Flow_27" name="Sí" sourceRef="Gateway_Conformidad" targetRef="Task_AprobarCierre" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_GestionarIncidencia" targetRef="Gateway_Continuar" />
    <bpmn:sequenceFlow id="Flow_29" name="Sí" sourceRef="Gateway_Continuar" targetRef="Task_EjecutarAtencion" />
    <bpmn:sequenceFlow id="Flow_30" name="No" sourceRef="Gateway_Continuar" targetRef="End_Escalada" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_AprobarCierre" targetRef="Task_CerrarNotificar" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CerrarNotificar" targetRef="End_Cerrada" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_CicloAsistencia">
    <bpmndi:BPMNPlane id="BPMNPlane_CicloAsistencia" bpmnElement="Collaboration_BarrioSolidario">
      <bpmndi:BPMNShape id="Participant_BarrioSolidario_di" bpmnElement="Participant_BarrioSolidario" isHorizontal="true">
