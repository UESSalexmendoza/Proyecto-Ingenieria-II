<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_RegistroSolicitud" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_RegistroSolicitud">
  <bpmn:participant id="Participant_RegistroSolicitud" name="Barrio Solidario - Registro de solicitud de asistencia" processRef="Process_RegistroSolicitud" />
 </bpmn:collaboration>
 <bpmn:process id="Process_RegistroSolicitud" name="Registro de solicitud de asistencia comunitaria" isExecutable="false">
  <bpmn:laneSet id="LaneSet_RegistroSolicitud">
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado">
    <bpmn:flowNodeRef>Start_Necesidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AbrirFormulario</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_SeleccionarBeneficiario</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DescribirNecesidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_DefinirUbicacionHorario</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarAccesibilidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AdjuntarEvidencias</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AccionSolicitud</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CorregirSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarContinuidad</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_ValidarCuentaVinculo</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Autorizado</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_DenegarRegistro</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoAutorizada</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_GuardarBorrador</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Borrador</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ValidarSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_SolicitudValida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_EvaluarRiesgoDuplicidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PosibleEmergencia</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_MostrarAdvertenciaEmergencia</bpmn:flowNodeRef><bpmn:flowNodeRef>End_DerivadaEmergencia</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_PosibleDuplicado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MostrarCoincidencia</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_RegistrarSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Registrada</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarNoAutorizado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarConfirmacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarCoordinacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_Necesidad" name="Necesidad de asistencia identificada" />
  <bpmn:userTask id="Task_AbrirFormulario" name="Abrir Registrar solicitud" />
  <bpmn:serviceTask id="Task_ValidarCuentaVinculo" name="Validar cuenta activa y vínculo con beneficiario" />
  <bpmn:exclusiveGateway id="Gateway_Autorizado" name="¿Puede registrar la solicitud?" />
  <bpmn:serviceTask id="Task_DenegarRegistro" name="Denegar registro y conservar motivo" />
  <bpmn:sendTask id="Task_NotificarNoAutorizado" name="Informar falta de autorización" />
  <bpmn:endEvent id="End_NoAutorizada" name="Solicitud no autorizada" />
  <bpmn:userTask id="Task_SeleccionarBeneficiario" name="Seleccionar beneficiario: propio o adulto vinculado" />
  <bpmn:userTask id="Task_DescribirNecesidad" name="Registrar categoría, descripción y prioridad" />
  <bpmn:userTask id="Task_DefinirUbicacionHorario" name="Definir zona aproximada y horario preferido" />
  <bpmn:userTask id="Task_RegistrarAccesibilidad" name="Registrar accesibilidad, restricciones y acompañamiento" />
  <bpmn:userTask id="Task_AdjuntarEvidencias" name="Adjuntar evidencia opcional y aceptar tratamiento de datos" />
  <bpmn:exclusiveGateway id="Gateway_AccionSolicitud" name="¿Guardar o enviar?" />
  <bpmn:serviceTask id="Task_GuardarBorrador" name="Guardar borrador privado" />
  <bpmn:endEvent id="End_Borrador" name="Borrador guardado" />
  <bpmn:serviceTask id="Task_ValidarSolicitud" name="Validar campos, catálogos, archivos y ubicación" />
  <bpmn:exclusiveGateway id="Gateway_SolicitudValida" name="¿Solicitud completa y válida?" />
  <bpmn:userTask id="Task_CorregirSolicitud" name="Corregir información señalada" />
  <bpmn:serviceTask id="Task_EvaluarRiesgoDuplicidad" name="Evaluar posible emergencia y solicitudes duplicadas" />
  <bpmn:exclusiveGateway id="Gateway_PosibleEmergencia" name="¿Posible emergencia inmediata?" />
  <bpmn:serviceTask id="Task_MostrarAdvertenciaEmergencia" name="Advertir que la plataforma no es un servicio de emergencias" />
  <bpmn:userTask id="Task_ConfirmarContinuidad" name="Contactar servicio de emergencia o continuar" />
  <bpmn:endEvent id="End_DerivadaEmergencia" name="Caso derivado a emergencia" />
  <bpmn:exclusiveGateway id="Gateway_PosibleDuplicado" name="¿Existe solicitud similar activa?" />
  <bpmn:serviceTask id="Task_MostrarCoincidencia" name="Mostrar solicitud similar sin exponer datos" />
  <bpmn:serviceTask id="Task_RegistrarSolicitud" name="Generar código y registrar estado Pendiente de revisión" />
  <bpmn:sendTask id="Task_NotificarConfirmacion" name="Enviar confirmación al solicitante" />
  <bpmn:sendTask id="Task_NotificarCoordinacion" name="Notificar nueva solicitud a coordinación" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar autor, beneficiario, fecha, estado y consentimiento" />
  <bpmn:endEvent id="End_Registrada" name="Solicitud registrada" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Necesidad" targetRef="Task_AbrirFormulario" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AbrirFormulario" targetRef="Task_ValidarCuentaVinculo" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarCuentaVinculo" targetRef="Gateway_Autorizado" />
  <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_Autorizado" targetRef="Task_DenegarRegistro" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_DenegarRegistro" targetRef="Task_NotificarNoAutorizado" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotificarNoAutorizado" targetRef="End_NoAutorizada" />
  <bpmn:sequenceFlow id="Flow_07" name="Sí" sourceRef="Gateway_Autorizado" targetRef="Task_SeleccionarBeneficiario" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SeleccionarBeneficiario" targetRef="Task_DescribirNecesidad" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DescribirNecesidad" targetRef="Task_DefinirUbicacionHorario" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DefinirUbicacionHorario" targetRef="Task_RegistrarAccesibilidad" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RegistrarAccesibilidad" targetRef="Task_AdjuntarEvidencias" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AdjuntarEvidencias" targetRef="Gateway_AccionSolicitud" />
  <bpmn:sequenceFlow id="Flow_13" name="Guardar borrador" sourceRef="Gateway_AccionSolicitud" targetRef="Task_GuardarBorrador" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_GuardarBorrador" targetRef="End_Borrador" />
  <bpmn:sequenceFlow id="Flow_15" name="Enviar" sourceRef="Gateway_AccionSolicitud" targetRef="Task_ValidarSolicitud" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ValidarSolicitud" targetRef="Gateway_SolicitudValida" />
  <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="Gateway_SolicitudValida" targetRef="Task_CorregirSolicitud" />
  <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CorregirSolicitud" targetRef="Task_ValidarSolicitud" />
  <bpmn:sequenceFlow id="Flow_19" name="Sí" sourceRef="Gateway_SolicitudValida" targetRef="Task_EvaluarRiesgoDuplicidad" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EvaluarRiesgoDuplicidad" targetRef="Gateway_PosibleEmergencia" />
  <bpmn:sequenceFlow id="Flow_21" name="Sí" sourceRef="Gateway_PosibleEmergencia" targetRef="Task_MostrarAdvertenciaEmergencia" />
  <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_MostrarAdvertenciaEmergencia" targetRef="Task_ConfirmarContinuidad" />
  <bpmn:sequenceFlow id="Flow_23" name="Contactar emergencia" sourceRef="Task_ConfirmarContinuidad" targetRef="End_DerivadaEmergencia" />
  <bpmn:sequenceFlow id="Flow_24" name="Continuar registro" sourceRef="Task_ConfirmarContinuidad" targetRef="Gateway_PosibleDuplicado" />
  <bpmn:sequenceFlow id="Flow_25" name="No" sourceRef="Gateway_PosibleEmergencia" targetRef="Gateway_PosibleDuplicado" />
  <bpmn:sequenceFlow id="Flow_26" name="Sí" sourceRef="Gateway_PosibleDuplicado" targetRef="Task_MostrarCoincidencia" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_MostrarCoincidencia" targetRef="Task_CorregirSolicitud" />
  <bpmn:sequenceFlow id="Flow_28" name="No" sourceRef="Gateway_PosibleDuplicado" targetRef="Task_RegistrarSolicitud" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RegistrarSolicitud" targetRef="Task_NotificarConfirmacion" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_NotificarConfirmacion" targetRef="Task_NotificarCoordinacion" />
  <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_NotificarCoordinacion" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Registrada" />

  <bpmn:textAnnotation id="Annotation_Privacidad"><bpmn:text>La ubicación se registra de forma aproximada durante la solicitud. Los datos detallados sólo se compartirán con personal autorizado cuando exista asignación. Barrio Solidario coordina apoyo comunitario y no sustituye a los servicios de emergencia.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Privacidad" sourceRef="Task_DefinirUbicacionHorario" targetRef="Annotation_Privacidad" />
 </bpmn:process>

