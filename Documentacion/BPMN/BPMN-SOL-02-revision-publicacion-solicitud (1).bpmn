  <bpmndi:BPMNShape id="ActualizarRech_di" bpmnElement="Task_ActualizarRechazada"><dc:Bounds x="1655" y="92" width="170" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="NotifRech_di" bpmnElement="Task_NotificarRechazo"><dc:Bounds x="1875" y="790" width="170" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EndRech_di" bpmnElement="End_Rechazada"><dc:Bounds x="2095" y="805" width="36" height="36"/></bpmndi:BPMNShape>
