  <bpmndi:BPMNEdge id="F27_di" bpmnElement="Flow_27"><di:waypoint x="2765" y="717"/><di:waypoint x="2815" y="717"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F28_di" bpmnElement="Flow_28"><di:waypoint x="3005" y="717"/><di:waypoint x="3055" y="717"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="Assoc_di" bpmnElement="Association_Publicacion"><di:waypoint x="1745" y="146"/><di:waypoint x="1745" y="150"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
