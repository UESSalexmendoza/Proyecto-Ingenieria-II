  <bpmndi:BPMNEdge id="F01_di" bpmnElement="Flow_01"><di:waypoint x="141" y="130"/><di:waypoint x="180" y="130"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F02_di" bpmnElement="Flow_02"><di:waypoint x="360" y="130"/><di:waypoint x="385" y="130"/><di:waypoint x="385" y="340"/><di:waypoint x="410" y="340"/></bpmndi:BPMNEdge>
