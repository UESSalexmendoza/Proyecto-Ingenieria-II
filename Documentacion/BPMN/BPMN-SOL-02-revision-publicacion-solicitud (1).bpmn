  <bpmndi:BPMNEdge id="F22_di" bpmnElement="Flow_22"><di:waypoint x="1605" y="365"/><di:waypoint x="1630" y="365"/><di:waypoint x="1630" y="108"/><di:waypoint x="1655" y="108"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F23_di" bpmnElement="Flow_23"><di:waypoint x="1835" y="108"/><di:waypoint x="1885" y="108"/></bpmndi:BPMNEdge>
