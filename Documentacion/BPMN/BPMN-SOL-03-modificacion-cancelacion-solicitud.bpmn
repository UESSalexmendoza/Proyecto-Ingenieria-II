<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_ModificacionCancelacion" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_ModificacionCancelacion">
  <bpmn:participant id="Participant_ModificacionCancelacion" name="Barrio Solidario - Modificación o cancelación de solicitud" processRef="Process_ModificacionCancelacion" />
 </bpmn:collaboration>
 <bpmn:process id="Process_ModificacionCancelacion" name="Modificación o cancelación de una solicitud de asistencia" isExecutable="false">
  <bpmn:laneSet id="LaneSet_ModificacionCancelacion">
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado">
    <bpmn:flowNodeRef>Start_GestionarSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SeleccionarSolicitud</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_Accion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EditarDatos</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_IndicarMotivo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarCancelacion</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_ValidarTitularEstado</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Permitida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_MostrarRestriccion</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoPermitida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ValidarCambios</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CambioMaterial</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ActualizarVersion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RetirarPublicacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_EnviarRevision</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarCambioMenor</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_Modificada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CancelarLiberar</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_Cancelada</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación / Moderación">
    <bpmn:flowNodeRef>Gateway_AtencionActiva</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EvaluarCancelacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_AutorizaCancelacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarNoAutorizada</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarModificacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarCancelacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarNoAutorizada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_RegistrarCancelacion</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_GestionarSolicitud" name="Usuario solicita modificar o cancelar" />
  <bpmn:userTask id="Task_SeleccionarSolicitud" name="Seleccionar solicitud y consultar estado" />
  <bpmn:serviceTask id="Task_ValidarTitularEstado" name="Validar titularidad, permisos y estado" />
  <bpmn:exclusiveGateway id="Gateway_Permitida" name="¿Gestión permitida?" />
  <bpmn:userTask id="Task_MostrarRestriccion" name="Informar restricción y alternativas de soporte" />
  <bpmn:endEvent id="End_NoPermitida" name="Gestión no permitida" />
  <bpmn:exclusiveGateway id="Gateway_Accion" name="¿Acción solicitada?" />

  <bpmn:userTask id="Task_EditarDatos" name="Editar información permitida y justificar cambio" />
  <bpmn:serviceTask id="Task_ValidarCambios" name="Validar campos, seguridad y datos sensibles" />
  <bpmn:exclusiveGateway id="Gateway_CambioMaterial" name="¿Cambio material o solicitud publicada?" />
  <bpmn:serviceTask id="Task_ActualizarVersion" name="Crear nueva versión de la solicitud" />
  <bpmn:serviceTask id="Task_RetirarPublicacion" name="Retirar temporalmente la publicación" />
  <bpmn:serviceTask id="Task_EnviarRevision" name="Cambiar estado a Pendiente de revisión" />
  <bpmn:serviceTask id="Task_ActualizarCambioMenor" name="Guardar cambio menor sin alterar asignación" />
  <bpmn:sendTask id="Task_NotificarModificacion" name="Notificar modificación y estado resultante" />
  <bpmn:endEvent id="End_Modificada" name="Solicitud modificada" />

  <bpmn:userTask id="Task_IndicarMotivo" name="Indicar motivo de cancelación" />
  <bpmn:userTask id="Task_ConfirmarCancelacion" name="Confirmar cancelación" />
  <bpmn:exclusiveGateway id="Gateway_AtencionActiva" name="¿Existe asignación o atención activa?" />
  <bpmn:userTask id="Task_EvaluarCancelacion" name="Evaluar impacto, seguridad y compromisos vigentes" />
  <bpmn:exclusiveGateway id="Gateway_AutorizaCancelacion" name="¿Cancelación autorizada?" />
  <bpmn:userTask id="Task_RegistrarNoAutorizada" name="Registrar motivo y alternativa de coordinación" />
  <bpmn:sendTask id="Task_NotificarNoAutorizada" name="Notificar que la cancelación requiere coordinación" />
  <bpmn:serviceTask id="Task_CancelarLiberar" name="Cancelar, retirar publicación y liberar asignación" />
  <bpmn:sendTask id="Task_NotificarCancelacion" name="Notificar al solicitante, voluntario y coordinación" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar acción, motivo, versión, fecha y responsable" />
  <bpmn:serviceTask id="Task_RegistrarCancelacion" name="Registrar cancelación, estado anterior, motivo y responsable" />
  <bpmn:endEvent id="End_Cancelada" name="Solicitud cancelada" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_GestionarSolicitud" targetRef="Task_SeleccionarSolicitud" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SeleccionarSolicitud" targetRef="Task_ValidarTitularEstado" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarTitularEstado" targetRef="Gateway_Permitida" />
  <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_Permitida" targetRef="Task_MostrarRestriccion" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_MostrarRestriccion" targetRef="End_NoPermitida" />
  <bpmn:sequenceFlow id="Flow_06" name="Sí" sourceRef="Gateway_Permitida" targetRef="Gateway_Accion" />
  <bpmn:sequenceFlow id="Flow_07" name="Modificar" sourceRef="Gateway_Accion" targetRef="Task_EditarDatos" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_EditarDatos" targetRef="Task_ValidarCambios" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ValidarCambios" targetRef="Gateway_CambioMaterial" />
  <bpmn:sequenceFlow id="Flow_10" name="Sí" sourceRef="Gateway_CambioMaterial" targetRef="Task_ActualizarVersion" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ActualizarVersion" targetRef="Task_RetirarPublicacion" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RetirarPublicacion" targetRef="Task_EnviarRevision" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_EnviarRevision" targetRef="Task_NotificarModificacion" />
  <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_CambioMaterial" targetRef="Task_ActualizarCambioMenor" />
  <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ActualizarCambioMenor" targetRef="Task_NotificarModificacion" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_NotificarModificacion" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Modificada" />
  <bpmn:sequenceFlow id="Flow_18" name="Cancelar" sourceRef="Gateway_Accion" targetRef="Task_IndicarMotivo" />
  <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_IndicarMotivo" targetRef="Task_ConfirmarCancelacion" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ConfirmarCancelacion" targetRef="Gateway_AtencionActiva" />
  <bpmn:sequenceFlow id="Flow_21" name="No" sourceRef="Gateway_AtencionActiva" targetRef="Task_CancelarLiberar" />
  <bpmn:sequenceFlow id="Flow_22" name="Sí" sourceRef="Gateway_AtencionActiva" targetRef="Task_EvaluarCancelacion" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_EvaluarCancelacion" targetRef="Gateway_AutorizaCancelacion" />
  <bpmn:sequenceFlow id="Flow_24" name="Sí" sourceRef="Gateway_AutorizaCancelacion" targetRef="Task_CancelarLiberar" />
  <bpmn:sequenceFlow id="Flow_25" name="No" sourceRef="Gateway_AutorizaCancelacion" targetRef="Task_RegistrarNoAutorizada" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RegistrarNoAutorizada" targetRef="Task_NotificarNoAutorizada" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_NotificarNoAutorizada" targetRef="End_NoPermitida" />
  <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_CancelarLiberar" targetRef="Task_NotificarCancelacion" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_NotificarCancelacion" targetRef="Task_RegistrarCancelacion" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_RegistrarCancelacion" targetRef="End_Cancelada" />

  <bpmn:textAnnotation id="Annotation_Reglas"><bpmn:text>No se permite modificar ni cancelar una solicitud Atendida, Cerrada, Rechazada o Cancelada. Los cambios de necesidad, prioridad, ubicación, horario o beneficiario generan una nueva versión y revisión. Durante una atención activa, la cancelación requiere coordinación para proteger a las partes y registrar el resultado.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Reglas" sourceRef="Task_ValidarTitularEstado" targetRef="Annotation_Reglas" />
 </bpmn:process>

 <bpmndi:BPMNDiagram id="Diagram_ModificacionCancelacion"><bpmndi:BPMNPlane id="Plane_ModificacionCancelacion" bpmnElement="Collaboration_ModificacionCancelacion">
  <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_ModificacionCancelacion" isHorizontal="true"><dc:Bounds x="30" y="30" width="4090" height="850"/></bpmndi:BPMNShape>
