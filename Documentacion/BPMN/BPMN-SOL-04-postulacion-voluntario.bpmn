  <bpmndi:BPMNShape id="NoDisp_di" bpmnElement="Task_InformarNoDisponible"><dc:Bounds x="2500" y="370" width="185" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EndNoDisp_di" bpmnElement="End_NoDisponible"><dc:Bounds x="2735" y="387" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Duplicado_di" bpmnElement="Task_VerificarDuplicado"><dc:Bounds x="2500" y="260" width="190" height="70"/></bpmndi:BPMNShape>
