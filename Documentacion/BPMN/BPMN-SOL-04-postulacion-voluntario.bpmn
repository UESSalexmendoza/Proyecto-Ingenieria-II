<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PostulacionVoluntario" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_PostulacionVoluntario">
  <bpmn:participant id="Participant_PostulacionVoluntario" name="Barrio Solidario - Postulación del voluntario" processRef="Process_PostulacionVoluntario" />
 </bpmn:collaboration>
 <bpmn:process id="Process_PostulacionVoluntario" name="Postulación de un voluntario a una solicitud de asistencia" isExecutable="false">
  <bpmn:laneSet id="LaneSet_PostulacionVoluntario">
   <bpmn:lane id="Lane_Voluntario" name="Voluntario">
    <bpmn:flowNodeRef>Start_ConsultarSolicitudes</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsultarDisponibles</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SeleccionarSolicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarDetalle</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarDisponibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AceptarCompromiso</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EnviarPostulacion</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_FiltrarSolicitudes</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Elegible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MostrarNoElegible</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoElegible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarVigencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Disponible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InformarNoDisponible</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoDisponible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_VerificarDuplicado</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Duplicada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InformarDuplicada</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Duplicada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CalcularCompatibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarPostulacion</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Registrada</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación / Moderación">
    <bpmn:flowNodeRef>Task_IncorporarBandeja</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarVoluntario</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarCoordinacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_ConsultarSolicitudes" name="Voluntario busca solicitudes disponibles" />
  <bpmn:userTask id="Task_ConsultarDisponibles" name="Consultar mapa o listado de solicitudes disponibles" />
  <bpmn:serviceTask id="Task_FiltrarSolicitudes" name="Filtrar por zona, disponibilidad, habilidades y prioridad" />
  <bpmn:userTask id="Task_SeleccionarSolicitud" name="Seleccionar solicitud" />
  <bpmn:userTask id="Task_RevisarDetalle" name="Revisar necesidad, zona aproximada, horario y condiciones" />
  <bpmn:serviceTask id="Task_ValidarPerfil" name="Validar perfil aprobado, cuenta activa, disponibilidad y conflictos" />
  <bpmn:exclusiveGateway id="Gateway_Elegible" name="¿Voluntario elegible?" />
  <bpmn:userTask id="Task_MostrarNoElegible" name="Informar requisito pendiente o restricción" />
  <bpmn:endEvent id="End_NoElegible" name="Postulación no habilitada" />
  <bpmn:userTask id="Task_ConfirmarDisponibilidad" name="Confirmar disponibilidad y forma de apoyo" />
  <bpmn:userTask id="Task_AceptarCompromiso" name="Aceptar reglas de voluntariado y confidencialidad" />
  <bpmn:userTask id="Task_EnviarPostulacion" name="Enviar postulación" />
  <bpmn:serviceTask id="Task_ValidarVigencia" name="Validar que la solicitud continúa publicada y sin cierre" />
  <bpmn:exclusiveGateway id="Gateway_Disponible" name="¿Solicitud disponible?" />
  <bpmn:userTask id="Task_InformarNoDisponible" name="Informar cambio de estado de la solicitud" />
  <bpmn:endEvent id="End_NoDisponible" name="Solicitud no disponible" />
  <bpmn:serviceTask id="Task_VerificarDuplicado" name="Verificar que no exista postulación activa del voluntario" />
  <bpmn:exclusiveGateway id="Gateway_Duplicada" name="¿Postulación duplicada?" />
  <bpmn:userTask id="Task_InformarDuplicada" name="Mostrar postulación existente" />
  <bpmn:endEvent id="End_Duplicada" name="Postulación existente" />
  <bpmn:serviceTask id="Task_CalcularCompatibilidad" name="Calcular distancia y compatibilidad del perfil" />
  <bpmn:serviceTask id="Task_RegistrarPostulacion" name="Registrar postulación en estado Pendiente de revisión" />
  <bpmn:userTask id="Task_IncorporarBandeja" name="Incorporar postulación a bandeja de coordinación" />
  <bpmn:sendTask id="Task_NotificarVoluntario" name="Confirmar recepción al voluntario" />
  <bpmn:sendTask id="Task_NotificarCoordinacion" name="Notificar nueva postulación a coordinación" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar fecha, solicitud, voluntario, estado y criterios" />
  <bpmn:endEvent id="End_Registrada" name="Postulación registrada" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_ConsultarSolicitudes" targetRef="Task_ConsultarDisponibles" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ConsultarDisponibles" targetRef="Task_FiltrarSolicitudes" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_FiltrarSolicitudes" targetRef="Task_SeleccionarSolicitud" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SeleccionarSolicitud" targetRef="Task_RevisarDetalle" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RevisarDetalle" targetRef="Task_ValidarPerfil" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ValidarPerfil" targetRef="Gateway_Elegible" />
  <bpmn:sequenceFlow id="Flow_07" name="No" sourceRef="Gateway_Elegible" targetRef="Task_MostrarNoElegible" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_MostrarNoElegible" targetRef="End_NoElegible" />
  <bpmn:sequenceFlow id="Flow_09" name="Sí" sourceRef="Gateway_Elegible" targetRef="Task_ConfirmarDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConfirmarDisponibilidad" targetRef="Task_AceptarCompromiso" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AceptarCompromiso" targetRef="Task_EnviarPostulacion" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_EnviarPostulacion" targetRef="Task_ValidarVigencia" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ValidarVigencia" targetRef="Gateway_Disponible" />
  <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_Disponible" targetRef="Task_InformarNoDisponible" />
  <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_InformarNoDisponible" targetRef="End_NoDisponible" />
  <bpmn:sequenceFlow id="Flow_16" name="Sí" sourceRef="Gateway_Disponible" targetRef="Task_VerificarDuplicado" />
  <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_VerificarDuplicado" targetRef="Gateway_Duplicada" />
  <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="Gateway_Duplicada" targetRef="Task_InformarDuplicada" />
  <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_InformarDuplicada" targetRef="End_Duplicada" />
  <bpmn:sequenceFlow id="Flow_20" name="No" sourceRef="Gateway_Duplicada" targetRef="Task_CalcularCompatibilidad" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CalcularCompatibilidad" targetRef="Task_RegistrarPostulacion" />
  <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_RegistrarPostulacion" targetRef="Task_IncorporarBandeja" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_IncorporarBandeja" targetRef="Task_NotificarVoluntario" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_NotificarVoluntario" targetRef="Task_NotificarCoordinacion" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_NotificarCoordinacion" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Registrada" />

  <bpmn:textAnnotation id="Annotation_Privacidad"><bpmn:text>Antes de la asignación, el voluntario sólo consulta categoría, descripción necesaria, zona aproximada, horario y condiciones generales. La identidad, datos de contacto y ubicación exacta del solicitante permanecen restringidos.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Privacidad" sourceRef="Task_RevisarDetalle" targetRef="Annotation_Privacidad" />
 </bpmn:process>

 <bpmndi:BPMNDiagram id="Diagram_PostulacionVoluntario"><bpmndi:BPMNPlane id="Plane_PostulacionVoluntario" bpmnElement="Collaboration_PostulacionVoluntario">
  <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_PostulacionVoluntario" isHorizontal="true"><dc:Bounds x="30" y="30" width="4030" height="850"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneVol_di" bpmnElement="Lane_Voluntario" isHorizontal="true"><dc:Bounds x="60" y="30" width="4000" height="205"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LanePlat_di" bpmnElement="Lane_Plataforma" isHorizontal="true"><dc:Bounds x="60" y="235" width="4000" height="225"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneCoord_di" bpmnElement="Lane_Coordinacion" isHorizontal="true"><dc:Bounds x="60" y="460" width="4000" height="190"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneNotif_di" bpmnElement="Lane_Notificaciones" isHorizontal="true"><dc:Bounds x="60" y="650" width="4000" height="230"/></bpmndi:BPMNShape>
