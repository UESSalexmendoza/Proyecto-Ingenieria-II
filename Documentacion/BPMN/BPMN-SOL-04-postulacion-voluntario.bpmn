  <bpmndi:BPMNShape id="InfDup_di" bpmnElement="Task_InformarDuplicada"><dc:Bounds x="2840" y="370" width="175" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="EndDup_di" bpmnElement="End_Duplicada"><dc:Bounds x="3065" y="387" width="36" height="36"/></bpmndi:BPMNShape>
