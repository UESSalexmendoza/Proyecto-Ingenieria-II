  <bpmndi:BPMNEdge id="F02_di" bpmnElement="Flow_02"><di:waypoint x="360" y="128"/><di:waypoint x="385" y="128"/><di:waypoint x="385" y="318"/><di:waypoint x="410" y="318"/></bpmndi:BPMNEdge>
