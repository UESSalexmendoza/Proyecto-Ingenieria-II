<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RevisionAsignacion" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_RevisionAsignacion"><bpmn:participant id="Participant_RevisionAsignacion" name="Barrio Solidario - Revisión y asignación del voluntario" processRef="Process_RevisionAsignacion" /></bpmn:collaboration>
 <bpmn:process id="Process_RevisionAsignacion" name="Revisión de postulaciones y asignación de voluntario" isExecutable="false">
  <bpmn:laneSet id="LaneSet_RevisionAsignacion">
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario"><bpmn:flowNodeRef>Start_PostulacionesPendientes</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsolidarPostulaciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarVigencia</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarObservada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarRechazada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevalidarDisponibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Disponible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CrearPreasignacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ExpirarPreasignacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FormalizarAsignacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CompartirDatosNecesarios</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Asignada</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SinAsignacion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Coordinacion" name="Coordinación / Moderación"><bpmn:flowNodeRef>Task_AbrirBandeja</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CompararCandidatos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisarPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EvaluarCompatibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ResultadoRevision</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DefinirObservaciones</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FundamentarRechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SeleccionarVoluntario</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_HayCandidatos</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Voluntario" name="Voluntario"><bpmn:flowNodeRef>Task_CorregirPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarAsignacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Confirma</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RechazarPreasignacion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Solicitante" name="Adulto mayor / Cuidador autorizado"><bpmn:flowNodeRef>Task_RecibirConfirmacion</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría"><bpmn:flowNodeRef>Task_NotificarObservacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarRechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SolicitarConfirmacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarNoDisponible</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarAsignacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_PostulacionesPendientes" name="Solicitud con postulaciones pendientes" />
  <bpmn:serviceTask id="Task_ConsolidarPostulaciones" name="Consolidar y ordenar postulaciones compatibles" />
  <bpmn:userTask id="Task_AbrirBandeja" name="Abrir postulaciones recibidas" />
  <bpmn:userTask id="Task_CompararCandidatos" name="Comparar distancia, habilidades, disponibilidad y antecedentes" />
  <bpmn:userTask id="Task_RevisarPerfil" name="Revisar perfil, validaciones, experiencia e incidencias" />
  <bpmn:serviceTask id="Task_ValidarVigencia" name="Validar cuenta activa, perfil aprobado y solicitud vigente" />
  <bpmn:userTask id="Task_EvaluarCompatibilidad" name="Evaluar idoneidad y riesgos para la atención" />
  <bpmn:exclusiveGateway id="Gateway_ResultadoRevision" name="¿Resultado de revisión?" />
  <bpmn:userTask id="Task_DefinirObservaciones" name="Definir información o corrección requerida" />
  <bpmn:serviceTask id="Task_RegistrarObservada" name="Cambiar postulación a Observada" />
  <bpmn:sendTask id="Task_NotificarObservacion" name="Notificar observación y plazo" />
  <bpmn:userTask id="Task_CorregirPerfil" name="Completar información y reenviar" />
  <bpmn:userTask id="Task_FundamentarRechazo" name="Registrar motivo de rechazo" />
  <bpmn:serviceTask id="Task_RegistrarRechazada" name="Cambiar postulación a Rechazada" />
  <bpmn:sendTask id="Task_NotificarRechazo" name="Notificar rechazo al voluntario" />
  <bpmn:exclusiveGateway id="Gateway_HayCandidatos" name="¿Existen más candidatos?" />
  <bpmn:endEvent id="End_SinAsignacion" name="Solicitud pendiente sin asignación" />
  <bpmn:userTask id="Task_SeleccionarVoluntario" name="Seleccionar voluntario recomendado" />
  <bpmn:serviceTask id="Task_RevalidarDisponibilidad" name="Revalidar disponibilidad y ausencia de conflictos" />
  <bpmn:exclusiveGateway id="Gateway_Disponible" name="¿Continúa disponible?" />
  <bpmn:sendTask id="Task_NotificarNoDisponible" name="Notificar indisponibilidad y continuar evaluación" />
  <bpmn:serviceTask id="Task_CrearPreasignacion" name="Crear preasignación con plazo de confirmación" />
  <bpmn:sendTask id="Task_SolicitarConfirmacion" name="Solicitar confirmación al voluntario" />
  <bpmn:userTask id="Task_ConfirmarAsignacion" name="Revisar condiciones y responder" />
  <bpmn:exclusiveGateway id="Gateway_Confirma" name="¿Acepta dentro del plazo?" />
  <bpmn:userTask id="Task_RechazarPreasignacion" name="Rechazar o dejar vencer la preasignación" />
  <bpmn:serviceTask id="Task_ExpirarPreasignacion" name="Liberar preasignación y reabrir selección" />
  <bpmn:serviceTask id="Task_FormalizarAsignacion" name="Asignar voluntario y cambiar solicitud a Asignada" />
  <bpmn:serviceTask id="Task_CompartirDatosNecesarios" name="Habilitar sólo datos necesarios para coordinar" />
  <bpmn:sendTask id="Task_NotificarAsignacion" name="Notificar asignación a las partes" />
  <bpmn:userTask id="Task_RecibirConfirmacion" name="Recibir datos de coordinación y voluntario asignado" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar criterios, decisión, responsables, fecha y estados" />
  <bpmn:endEvent id="End_Asignada" name="Voluntario asignado" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_PostulacionesPendientes" targetRef="Task_ConsolidarPostulaciones" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ConsolidarPostulaciones" targetRef="Task_AbrirBandeja" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AbrirBandeja" targetRef="Task_CompararCandidatos" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CompararCandidatos" targetRef="Task_RevisarPerfil" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RevisarPerfil" targetRef="Task_ValidarVigencia" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ValidarVigencia" targetRef="Task_EvaluarCompatibilidad" />
  <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_EvaluarCompatibilidad" targetRef="Gateway_ResultadoRevision" />
  <bpmn:sequenceFlow id="Flow_08" name="Observar" sourceRef="Gateway_ResultadoRevision" targetRef="Task_DefinirObservaciones" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DefinirObservaciones" targetRef="Task_RegistrarObservada" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RegistrarObservada" targetRef="Task_NotificarObservacion" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotificarObservacion" targetRef="Task_CorregirPerfil" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CorregirPerfil" targetRef="Task_ValidarVigencia" />
  <bpmn:sequenceFlow id="Flow_13" name="Rechazar" sourceRef="Gateway_ResultadoRevision" targetRef="Task_FundamentarRechazo" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_FundamentarRechazo" targetRef="Task_RegistrarRechazada" />
  <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RegistrarRechazada" targetRef="Task_NotificarRechazo" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_NotificarRechazo" targetRef="Gateway_HayCandidatos" />
  <bpmn:sequenceFlow id="Flow_17" name="Sí" sourceRef="Gateway_HayCandidatos" targetRef="Task_CompararCandidatos" />
  <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_HayCandidatos" targetRef="End_SinAsignacion" />
  <bpmn:sequenceFlow id="Flow_19" name="Aprobar" sourceRef="Gateway_ResultadoRevision" targetRef="Task_SeleccionarVoluntario" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SeleccionarVoluntario" targetRef="Task_RevalidarDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_RevalidarDisponibilidad" targetRef="Gateway_Disponible" />
  <bpmn:sequenceFlow id="Flow_22" name="No" sourceRef="Gateway_Disponible" targetRef="Task_NotificarNoDisponible" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_NotificarNoDisponible" targetRef="Gateway_HayCandidatos" />
  <bpmn:sequenceFlow id="Flow_24" name="Sí" sourceRef="Gateway_Disponible" targetRef="Task_CrearPreasignacion" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CrearPreasignacion" targetRef="Task_SolicitarConfirmacion" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SolicitarConfirmacion" targetRef="Task_ConfirmarAsignacion" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ConfirmarAsignacion" targetRef="Gateway_Confirma" />
  <bpmn:sequenceFlow id="Flow_28" name="No o vence" sourceRef="Gateway_Confirma" targetRef="Task_RechazarPreasignacion" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RechazarPreasignacion" targetRef="Task_ExpirarPreasignacion" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_ExpirarPreasignacion" targetRef="Gateway_HayCandidatos" />
  <bpmn:sequenceFlow id="Flow_31" name="Sí" sourceRef="Gateway_Confirma" targetRef="Task_FormalizarAsignacion" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_FormalizarAsignacion" targetRef="Task_CompartirDatosNecesarios" />
  <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_CompartirDatosNecesarios" targetRef="Task_NotificarAsignacion" />
  <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_NotificarAsignacion" targetRef="Task_RecibirConfirmacion" />
  <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_RecibirConfirmacion" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Asignada" />

  <bpmn:textAnnotation id="Annotation_Criterios"><bpmn:text>La selección considera perfil aprobado, capacidades, disponibilidad, distancia, antecedentes, incidencias y posibles conflictos. No debe basarse únicamente en cercanía. Los datos personales y la ubicación exacta se comparten sólo después de la confirmación y según necesidad.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Criterios" sourceRef="Task_CompararCandidatos" targetRef="Annotation_Criterios" />
 </bpmn:process>

