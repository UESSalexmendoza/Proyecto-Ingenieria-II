      <bpmndi:BPMNShape id="Task_CorregirDatos_di" bpmnElement="Task_CorregirDatos"><dc:Bounds x="790" y="92" width="160" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CrearCuentaPendiente_di" bpmnElement="Task_CrearCuentaPendiente"><dc:Bounds x="950" y="300" width="180" height="76" /></bpmndi:BPMNShape>
