      <bpmndi:BPMNShape id="Gateway_RequiereRevision_di" bpmnElement="Gateway_RequiereRevision" isMarkerVisible="true"><dc:Bounds x="1750" y="313" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarPendiente_di" bpmnElement="Task_NotificarPendiente"><dc:Bounds x="1850" y="505" width="170" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarPerfil_di" bpmnElement="Task_RevisarPerfil"><dc:Bounds x="2070" y="710" width="170" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DecisionRevision_di" bpmnElement="Gateway_DecisionRevision" isMarkerVisible="true"><dc:Bounds x="2290" y="723" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarObservacion_di" bpmnElement="Task_NotificarObservacion"><dc:Bounds x="2390" y="505" width="170" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompletarObservaciones_di" bpmnElement="Task_CompletarObservaciones"><dc:Bounds x="2390" y="92" width="180" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarDecision_di" bpmnElement="Task_RegistrarDecision"><dc:Bounds x="2440" y="300" width="180" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ActivarCuenta_di" bpmnElement="Task_ActivarCuenta"><dc:Bounds x="2690" y="300" width="170" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarActivacion_di" bpmnElement="Task_NotificarActivacion"><dc:Bounds x="2910" y="505" width="170" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Activo_di" bpmnElement="End_Activo"><dc:Bounds x="3130" y="525" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CerrarRegistroRechazado_di" bpmnElement="Task_CerrarRegistroRechazado"><dc:Bounds x="2510" y="385" width="180" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarRechazo_di" bpmnElement="Task_NotificarRechazo"><dc:Bounds x="2750" y="590" width="170" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rechazado_di" bpmnElement="End_Rechazado"><dc:Bounds x="2970" y="597" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Roles_di" bpmnElement="TextAnnotation_Roles"><dc:Bounds x="1700" y="245" width="380" height="55" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="141" y="130"/><di:waypoint x="180" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="350" y="130"/><di:waypoint x="390" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="560" y="130"/><di:waypoint x="585" y="130"/><di:waypoint x="585" y="338"/><di:waypoint x="610" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="790" y="338"/><di:waypoint x="840" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="865" y="313"/><di:waypoint x="865" y="168"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="950" y="130"/><di:waypoint x="970" y="130"/><di:waypoint x="970" y="270"/><di:waypoint x="700" y="270"/><di:waypoint x="700" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="890" y="338"/><di:waypoint x="950" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1130" y="338"/><di:waypoint x="1155" y="338"/><di:waypoint x="1155" y="543"/><di:waypoint x="1180" y="543"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1350" y="543"/><di:waypoint x="1375" y="543"/><di:waypoint x="1375" y="130"/><di:waypoint x="1400" y="130"/></bpmndi:BPMNEdge>
