<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_RegistroAltaUsuarios"
  targetNamespace="https://barriosolidario.org/bpmn">

  <bpmn:collaboration id="Collaboration_RegistroAltaUsuarios">
    <bpmn:participant id="Participant_RegistroAltaUsuarios" name="Barrio Solidario - Registro y alta de usuarios" processRef="Process_RegistroAltaUsuarios" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RegistroAltaUsuarios" name="Registro, revisión y alta de usuarios" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RegistroAlta">
      <bpmn:lane id="Lane_Solicitante" name="Persona solicitante">
        <bpmn:flowNodeRef>Start_Registro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AceptarPoliticas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletarFormulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarCorreo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletarObservaciones</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
        <bpmn:flowNodeRef>Task_ValidarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatosValidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearCuentaPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CorreoVerificado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequiereRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivarCuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CerrarRegistroRechazado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Activo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Notificaciones" name="Servicio de notificaciones">
        <bpmn:flowNodeRef>Task_EnviarEnlace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarActivacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarObservacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarRechazo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Administracion" name="Moderación / Administración">
        <bpmn:flowNodeRef>Task_RevisarPerfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionRevision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Registro" name="Necesidad de crear cuenta" />
    <bpmn:userTask id="Task_AceptarPoliticas" name="Seleccionar rol y aceptar políticas" />
    <bpmn:userTask id="Task_CompletarFormulario" name="Completar datos de registro" />
    <bpmn:serviceTask id="Task_ValidarDatos" name="Validar campos, duplicidad y contraseña" />
    <bpmn:exclusiveGateway id="Gateway_DatosValidos" name="¿Datos válidos?" />
    <bpmn:userTask id="Task_CorregirDatos" name="Corregir datos observados" />
    <bpmn:serviceTask id="Task_CrearCuentaPendiente" name="Crear cuenta en estado pendiente" />
    <bpmn:sendTask id="Task_EnviarEnlace" name="Enviar enlace de verificación" />
    <bpmn:userTask id="Task_VerificarCorreo" name="Verificar correo electrónico" />
    <bpmn:exclusiveGateway id="Gateway_CorreoVerificado" name="¿Correo verificado?" />
    <bpmn:exclusiveGateway id="Gateway_RequiereRevision" name="¿Rol requiere revisión?" />
    <bpmn:sendTask id="Task_NotificarPendiente" name="Notificar registro pendiente" />
    <bpmn:userTask id="Task_RevisarPerfil" name="Revisar perfil y requisitos" />
    <bpmn:exclusiveGateway id="Gateway_DecisionRevision" name="¿Decisión de revisión?" />
    <bpmn:sendTask id="Task_NotificarObservacion" name="Notificar observaciones" />
    <bpmn:userTask id="Task_CompletarObservaciones" name="Completar o corregir requisitos" />
    <bpmn:serviceTask id="Task_RegistrarDecision" name="Registrar aprobación y trazabilidad" />
    <bpmn:serviceTask id="Task_ActivarCuenta" name="Activar cuenta y asignar rol" />
    <bpmn:sendTask id="Task_NotificarActivacion" name="Notificar activación y acceso" />
    <bpmn:endEvent id="End_Activo" name="Usuario activo" />
    <bpmn:serviceTask id="Task_CerrarRegistroRechazado" name="Registrar rechazo" />
    <bpmn:sendTask id="Task_NotificarRechazo" name="Notificar rechazo y motivo" />
    <bpmn:endEvent id="End_Rechazado" name="Registro rechazado" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Registro" targetRef="Task_AceptarPoliticas" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AceptarPoliticas" targetRef="Task_CompletarFormulario" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CompletarFormulario" targetRef="Task_ValidarDatos" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ValidarDatos" targetRef="Gateway_DatosValidos" />
    <bpmn:sequenceFlow id="Flow_05" name="No" sourceRef="Gateway_DatosValidos" targetRef="Task_CorregirDatos" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CorregirDatos" targetRef="Task_ValidarDatos" />
    <bpmn:sequenceFlow id="Flow_07" name="Sí" sourceRef="Gateway_DatosValidos" targetRef="Task_CrearCuentaPendiente" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CrearCuentaPendiente" targetRef="Task_EnviarEnlace" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_EnviarEnlace" targetRef="Task_VerificarCorreo" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_VerificarCorreo" targetRef="Gateway_CorreoVerificado" />
    <bpmn:sequenceFlow id="Flow_11" name="No / enlace vencido" sourceRef="Gateway_CorreoVerificado" targetRef="Task_EnviarEnlace" />
    <bpmn:sequenceFlow id="Flow_12" name="Sí" sourceRef="Gateway_CorreoVerificado" targetRef="Gateway_RequiereRevision" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_RequiereRevision" targetRef="Task_ActivarCuenta" />
    <bpmn:sequenceFlow id="Flow_14" name="Sí" sourceRef="Gateway_RequiereRevision" targetRef="Task_NotificarPendiente" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NotificarPendiente" targetRef="Task_RevisarPerfil" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RevisarPerfil" targetRef="Gateway_DecisionRevision" />
    <bpmn:sequenceFlow id="Flow_17" name="Observado" sourceRef="Gateway_DecisionRevision" targetRef="Task_NotificarObservacion" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_NotificarObservacion" targetRef="Task_CompletarObservaciones" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CompletarObservaciones" targetRef="Task_RevisarPerfil" />
    <bpmn:sequenceFlow id="Flow_20" name="Aprobado" sourceRef="Gateway_DecisionRevision" targetRef="Task_RegistrarDecision" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_RegistrarDecision" targetRef="Task_ActivarCuenta" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ActivarCuenta" targetRef="Task_NotificarActivacion" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_NotificarActivacion" targetRef="End_Activo" />
    <bpmn:sequenceFlow id="Flow_24" name="Rechazado" sourceRef="Gateway_DecisionRevision" targetRef="Task_CerrarRegistroRechazado" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CerrarRegistroRechazado" targetRef="Task_NotificarRechazo" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_NotificarRechazo" targetRef="End_Rechazado" />

    <bpmn:textAnnotation id="TextAnnotation_Roles">
      <bpmn:text>Revisión recomendada para Voluntario, Institución aliada y roles administrativos. Adulto mayor o Cuidador pueden activarse tras validar identidad y correo, según las reglas vigentes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Roles" sourceRef="Gateway_RequiereRevision" targetRef="TextAnnotation_Roles" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_RegistroAltaUsuarios">
    <bpmndi:BPMNPlane id="BPMNPlane_RegistroAltaUsuarios" bpmnElement="Collaboration_RegistroAltaUsuarios">
      <bpmndi:BPMNShape id="Participant_RegistroAltaUsuarios_di" bpmnElement="Participant_RegistroAltaUsuarios" isHorizontal="true"><dc:Bounds x="30" y="30" width="3420" height="820" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Solicitante_di" bpmnElement="Lane_Solicitante" isHorizontal="true"><dc:Bounds x="60" y="30" width="3390" height="205" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Plataforma_di" bpmnElement="Lane_Plataforma" isHorizontal="true"><dc:Bounds x="60" y="235" width="3390" height="205" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Notificaciones_di" bpmnElement="Lane_Notificaciones" isHorizontal="true"><dc:Bounds x="60" y="440" width="3390" height="205" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Administracion_di" bpmnElement="Lane_Administracion" isHorizontal="true"><dc:Bounds x="60" y="645" width="3390" height="205" /></bpmndi:BPMNShape>

