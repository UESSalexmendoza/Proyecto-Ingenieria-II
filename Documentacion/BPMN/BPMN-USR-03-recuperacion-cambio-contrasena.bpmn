  <bpmndi:BPMNShape id="GwActual_di" bpmnElement="Gateway_ClaveActualValida" isMarkerVisible="true"><dc:Bounds x="1570" y="440" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CorregirActual_di" bpmnElement="Task_CorregirClaveActual"><dc:Bounds x="1530" y="175" width="170" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Nueva_di" bpmnElement="Task_DefinirNuevaClave"><dc:Bounds x="2040" y="80" width="190" height="76"/></bpmndi:BPMNShape>
