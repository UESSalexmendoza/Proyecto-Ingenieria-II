<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_GestionPerfil" targetNamespace="https://barriosolidario.org/bpmn">

 <bpmn:collaboration id="Collaboration_GestionPerfil">
  <bpmn:participant id="Participant_GestionPerfil" name="Barrio Solidario - Gestión del perfil" processRef="Process_GestionPerfil" />
 </bpmn:collaboration>

 <bpmn:process id="Process_GestionPerfil" name="Gestión y actualización del perfil de usuario" isExecutable="false">
  <bpmn:laneSet id="LaneSet_GestionPerfil">
   <bpmn:lane id="Lane_Usuario" name="Usuario autenticado">
    <bpmn:flowNodeRef>Start_GestionPerfil</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ConsultarPerfil</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_SeleccionarActualizacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_EditarDatosComunes</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_EditarDatosRol</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_EditarDatosSensibles</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ConfirmarIdentidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CorregirInformacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AtenderObservaciones</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_CargarPerfilPermisos</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_TipoActualizacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_Reautenticacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ValidarInformacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_InformacionValida</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_RequiereRevision</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_GuardarCambios</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CrearSolicitudRevision</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AplicarCambiosAprobados</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_MantenerPerfilAnterior</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_PerfilActualizado</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_CambioRechazado</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Revision" name="Moderación / Administración">
    <bpmn:flowNodeRef>Task_RevisarCambios</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_DecisionRevision</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Auditoria" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarPendiente</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarObservaciones</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarResultado</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_GestionPerfil" name="Necesidad de consultar o actualizar perfil" />
  <bpmn:userTask id="Task_ConsultarPerfil" name="Ingresar a Mi perfil" />
  <bpmn:serviceTask id="Task_CargarPerfilPermisos" name="Cargar perfil y campos autorizados según rol" />
  <bpmn:userTask id="Task_SeleccionarActualizacion" name="Seleccionar información a actualizar" />
  <bpmn:exclusiveGateway id="Gateway_TipoActualizacion" name="¿Tipo de actualización?" />
  <bpmn:userTask id="Task_EditarDatosComunes" name="Editar datos comunes y preferencias" />
  <bpmn:userTask id="Task_EditarDatosRol" name="Editar información específica del rol" />
  <bpmn:userTask id="Task_EditarDatosSensibles" name="Editar identidad, contacto o vínculo" />
  <bpmn:exclusiveGateway id="Gateway_Reautenticacion" name="¿Requiere confirmar identidad?" />
  <bpmn:userTask id="Task_ConfirmarIdentidad" name="Confirmar contraseña o segundo factor" />
  <bpmn:serviceTask id="Task_ValidarInformacion" name="Validar formato, integridad y permisos" />
  <bpmn:exclusiveGateway id="Gateway_InformacionValida" name="¿Información válida?" />
  <bpmn:userTask id="Task_CorregirInformacion" name="Corregir información indicada" />
  <bpmn:exclusiveGateway id="Gateway_RequiereRevision" name="¿Cambio requiere revisión?" />
  <bpmn:serviceTask id="Task_GuardarCambios" name="Guardar cambios autorizados" />
  <bpmn:serviceTask id="Task_CrearSolicitudRevision" name="Crear solicitud de revisión manteniendo perfil vigente" />
  <bpmn:sendTask id="Task_NotificarPendiente" name="Notificar cambio pendiente" />
  <bpmn:userTask id="Task_RevisarCambios" name="Revisar evidencias, vínculo y requisitos del rol" />
  <bpmn:exclusiveGateway id="Gateway_DecisionRevision" name="¿Resultado de la revisión?" />
  <bpmn:sendTask id="Task_NotificarObservaciones" name="Notificar observaciones" />
  <bpmn:userTask id="Task_AtenderObservaciones" name="Completar o corregir cambios" />
  <bpmn:serviceTask id="Task_AplicarCambiosAprobados" name="Aplicar cambios aprobados" />
  <bpmn:serviceTask id="Task_MantenerPerfilAnterior" name="Rechazar cambio y mantener perfil anterior" />
  <bpmn:sendTask id="Task_NotificarResultado" name="Notificar resultado de actualización" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar versión, responsable, fecha y cambios" />
  <bpmn:endEvent id="End_PerfilActualizado" name="Perfil actualizado" />
  <bpmn:endEvent id="End_CambioRechazado" name="Cambio rechazado" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_GestionPerfil" targetRef="Task_ConsultarPerfil" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ConsultarPerfil" targetRef="Task_CargarPerfilPermisos" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CargarPerfilPermisos" targetRef="Task_SeleccionarActualizacion" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SeleccionarActualizacion" targetRef="Gateway_TipoActualizacion" />
  <bpmn:sequenceFlow id="Flow_05" name="Datos comunes" sourceRef="Gateway_TipoActualizacion" targetRef="Task_EditarDatosComunes" />
  <bpmn:sequenceFlow id="Flow_06" name="Datos del rol" sourceRef="Gateway_TipoActualizacion" targetRef="Task_EditarDatosRol" />
  <bpmn:sequenceFlow id="Flow_07" name="Datos sensibles" sourceRef="Gateway_TipoActualizacion" targetRef="Task_EditarDatosSensibles" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_EditarDatosComunes" targetRef="Gateway_Reautenticacion" />
  <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_EditarDatosRol" targetRef="Gateway_Reautenticacion" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_EditarDatosSensibles" targetRef="Gateway_Reautenticacion" />
  <bpmn:sequenceFlow id="Flow_11" name="Sí" sourceRef="Gateway_Reautenticacion" targetRef="Task_ConfirmarIdentidad" />
  <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Reautenticacion" targetRef="Task_ValidarInformacion" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConfirmarIdentidad" targetRef="Task_ValidarInformacion" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ValidarInformacion" targetRef="Gateway_InformacionValida" />
  <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_InformacionValida" targetRef="Task_CorregirInformacion" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CorregirInformacion" targetRef="Task_ValidarInformacion" />
  <bpmn:sequenceFlow id="Flow_17" name="Sí" sourceRef="Gateway_InformacionValida" targetRef="Gateway_RequiereRevision" />
  <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_RequiereRevision" targetRef="Task_GuardarCambios" />
  <bpmn:sequenceFlow id="Flow_19" name="Sí" sourceRef="Gateway_RequiereRevision" targetRef="Task_CrearSolicitudRevision" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CrearSolicitudRevision" targetRef="Task_NotificarPendiente" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_NotificarPendiente" targetRef="Task_RevisarCambios" />
  <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_RevisarCambios" targetRef="Gateway_DecisionRevision" />
  <bpmn:sequenceFlow id="Flow_23" name="Observado" sourceRef="Gateway_DecisionRevision" targetRef="Task_NotificarObservaciones" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_NotificarObservaciones" targetRef="Task_AtenderObservaciones" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_AtenderObservaciones" targetRef="Task_ValidarInformacion" />
  <bpmn:sequenceFlow id="Flow_26" name="Aprobado" sourceRef="Gateway_DecisionRevision" targetRef="Task_AplicarCambiosAprobados" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_AplicarCambiosAprobados" targetRef="Task_NotificarResultado" />
  <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_GuardarCambios" targetRef="Task_NotificarResultado" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_NotificarResultado" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_PerfilActualizado" />
  <bpmn:sequenceFlow id="Flow_31" name="Rechazado" sourceRef="Gateway_DecisionRevision" targetRef="Task_MantenerPerfilAnterior" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_MantenerPerfilAnterior" targetRef="End_CambioRechazado" />

  <bpmn:textAnnotation id="Annotation_Roles"><bpmn:text>Datos por rol: Adulto mayor: apoyos, restricciones y preferencias de contacto. Cuidador: vínculo y autorización. Voluntario: habilidades, zona, horarios y disponibilidad. Institución: datos y responsable. Cambios de identidad, vínculo, rol o documentos requieren revisión.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Roles" sourceRef="Task_EditarDatosRol" targetRef="Annotation_Roles" />
 </bpmn:process>

