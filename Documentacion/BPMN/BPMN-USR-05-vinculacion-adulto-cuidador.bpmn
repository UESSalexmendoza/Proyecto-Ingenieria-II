<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_Vinculacion" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_Vinculacion">
  <bpmn:participant id="Participant_Vinculacion" name="Barrio Solidario - Vinculación del adulto mayor con el cuidador" processRef="Process_Vinculacion" />
 </bpmn:collaboration>
 <bpmn:process id="Process_Vinculacion" name="Vinculación del adulto mayor con el cuidador o familiar" isExecutable="false">
  <bpmn:laneSet id="LaneSet_Vinculacion">
   <bpmn:lane id="Lane_Adulto" name="Adulto mayor">
    <bpmn:flowNodeRef>Start_Adulto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SolicitarCuidador</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ConfirmarConsentimiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DefinirPermisos</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Cuidador" name="Cuidador / Familiar">
    <bpmn:flowNodeRef>Start_Cuidador</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SolicitarAdulto</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AceptarResponsabilidades</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdjuntarRespaldo</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CorregirRespaldo</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_ValidarParticipantes</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ParticipantesValidos</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_Iniciador</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RespuestaInvitacion</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_RequiereRespaldo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarRespaldo</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_RespaldoValido</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CrearSolicitudRevision</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CrearVinculo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AsignarPermisos</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_RegistrarRechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Vinculado</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_NoVinculado</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Revision" name="Moderación / Administración">
    <bpmn:flowNodeRef>Task_RevisarVinculo</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DecisionRevision</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarSolicitudInvalida</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InvitarCuidador</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_InvitarAdulto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarObservaciones</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarResultado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_Adulto" name="El adulto mayor solicita acompañamiento" />
  <bpmn:userTask id="Task_SolicitarCuidador" name="Identificar e invitar cuidador o familiar" />
  <bpmn:startEvent id="Start_Cuidador" name="El cuidador solicita representar al adulto" />
  <bpmn:userTask id="Task_SolicitarAdulto" name="Identificar adulto mayor y declarar vínculo" />
  <bpmn:serviceTask id="Task_ValidarParticipantes" name="Validar cuentas, roles, duplicidad y conflictos" />
  <bpmn:exclusiveGateway id="Gateway_ParticipantesValidos" name="¿Participantes habilitados?" />
  <bpmn:sendTask id="Task_NotificarSolicitudInvalida" name="Informar motivo sin exponer datos personales" />
  <bpmn:endEvent id="End_NoVinculado" name="Vinculación no creada" />
  <bpmn:exclusiveGateway id="Gateway_Iniciador" name="¿Quién inició la solicitud?" />
  <bpmn:sendTask id="Task_InvitarCuidador" name="Enviar invitación al cuidador" />
  <bpmn:userTask id="Task_AceptarResponsabilidades" name="Aceptar responsabilidades y condiciones" />
  <bpmn:sendTask id="Task_InvitarAdulto" name="Solicitar consentimiento al adulto mayor" />
  <bpmn:userTask id="Task_ConfirmarConsentimiento" name="Confirmar consentimiento o representación" />
  <bpmn:exclusiveGateway id="Gateway_RespuestaInvitacion" name="¿Respuesta de la contraparte?" />
  <bpmn:serviceTask id="Task_RegistrarRechazo" name="Registrar rechazo o vencimiento" />
  <bpmn:userTask id="Task_DefinirPermisos" name="Definir alcance de permisos del cuidador" />
  <bpmn:exclusiveGateway id="Gateway_RequiereRespaldo" name="¿Requiere autorización o respaldo?" />
  <bpmn:userTask id="Task_AdjuntarRespaldo" name="Adjuntar autorización o respaldo del vínculo" />
  <bpmn:serviceTask id="Task_ValidarRespaldo" name="Validar integridad y formato del respaldo" />
  <bpmn:exclusiveGateway id="Gateway_RespaldoValido" name="¿Respaldo válido?" />
  <bpmn:userTask id="Task_CorregirRespaldo" name="Corregir o completar respaldo" />
  <bpmn:serviceTask id="Task_CrearSolicitudRevision" name="Crear solicitud de revisión" />
  <bpmn:userTask id="Task_RevisarVinculo" name="Revisar consentimiento, relación y alcance" />
  <bpmn:exclusiveGateway id="Gateway_DecisionRevision" name="¿Decisión de revisión?" />
  <bpmn:sendTask id="Task_NotificarObservaciones" name="Notificar observaciones" />
  <bpmn:serviceTask id="Task_CrearVinculo" name="Crear vínculo activo entre perfiles" />
  <bpmn:serviceTask id="Task_AsignarPermisos" name="Aplicar permisos mínimos autorizados" />
  <bpmn:sendTask id="Task_NotificarResultado" name="Notificar resultado a ambas partes" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar consentimiento, permisos, fechas y responsables" />
  <bpmn:endEvent id="End_Vinculado" name="Adulto mayor y cuidador vinculados" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Adulto" targetRef="Task_SolicitarCuidador" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SolicitarCuidador" targetRef="Task_ValidarParticipantes" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Start_Cuidador" targetRef="Task_SolicitarAdulto" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SolicitarAdulto" targetRef="Task_ValidarParticipantes" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ValidarParticipantes" targetRef="Gateway_ParticipantesValidos" />
  <bpmn:sequenceFlow id="Flow_06" name="No" sourceRef="Gateway_ParticipantesValidos" targetRef="Task_NotificarSolicitudInvalida" />
  <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotificarSolicitudInvalida" targetRef="End_NoVinculado" />
  <bpmn:sequenceFlow id="Flow_08" name="Sí" sourceRef="Gateway_ParticipantesValidos" targetRef="Gateway_Iniciador" />
  <bpmn:sequenceFlow id="Flow_09" name="Adulto mayor" sourceRef="Gateway_Iniciador" targetRef="Task_InvitarCuidador" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InvitarCuidador" targetRef="Task_AceptarResponsabilidades" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AceptarResponsabilidades" targetRef="Gateway_RespuestaInvitacion" />
  <bpmn:sequenceFlow id="Flow_12" name="Cuidador" sourceRef="Gateway_Iniciador" targetRef="Task_InvitarAdulto" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_InvitarAdulto" targetRef="Task_ConfirmarConsentimiento" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ConfirmarConsentimiento" targetRef="Gateway_RespuestaInvitacion" />
  <bpmn:sequenceFlow id="Flow_15" name="Rechazada o vencida" sourceRef="Gateway_RespuestaInvitacion" targetRef="Task_RegistrarRechazo" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RegistrarRechazo" targetRef="Task_NotificarResultado" />
  <bpmn:sequenceFlow id="Flow_17" name="Aceptada" sourceRef="Gateway_RespuestaInvitacion" targetRef="Task_DefinirPermisos" />
  <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DefinirPermisos" targetRef="Gateway_RequiereRespaldo" />
  <bpmn:sequenceFlow id="Flow_19" name="Sí" sourceRef="Gateway_RequiereRespaldo" targetRef="Task_AdjuntarRespaldo" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AdjuntarRespaldo" targetRef="Task_ValidarRespaldo" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ValidarRespaldo" targetRef="Gateway_RespaldoValido" />
  <bpmn:sequenceFlow id="Flow_22" name="No" sourceRef="Gateway_RespaldoValido" targetRef="Task_CorregirRespaldo" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_CorregirRespaldo" targetRef="Task_ValidarRespaldo" />
  <bpmn:sequenceFlow id="Flow_24" name="Sí" sourceRef="Gateway_RespaldoValido" targetRef="Task_CrearSolicitudRevision" />
  <bpmn:sequenceFlow id="Flow_25" name="No" sourceRef="Gateway_RequiereRespaldo" targetRef="Task_CrearSolicitudRevision" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_CrearSolicitudRevision" targetRef="Task_RevisarVinculo" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RevisarVinculo" targetRef="Gateway_DecisionRevision" />
  <bpmn:sequenceFlow id="Flow_28" name="Observado" sourceRef="Gateway_DecisionRevision" targetRef="Task_NotificarObservaciones" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_NotificarObservaciones" targetRef="Task_CorregirRespaldo" />
  <bpmn:sequenceFlow id="Flow_30" name="Rechazado" sourceRef="Gateway_DecisionRevision" targetRef="Task_RegistrarRechazo" />
  <bpmn:sequenceFlow id="Flow_31" name="Aprobado" sourceRef="Gateway_DecisionRevision" targetRef="Task_CrearVinculo" />
  <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CrearVinculo" targetRef="Task_AsignarPermisos" />
  <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_AsignarPermisos" targetRef="Task_NotificarResultado" />
  <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_NotificarResultado" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_Vinculado" />

  <bpmn:textAnnotation id="Annotation_Principios"><bpmn:text>La vinculación no implica compartir contraseñas. El cuidador actúa con permisos mínimos y trazables. Se requiere consentimiento verificable del adulto mayor o representación legal documentada. El vínculo podrá revocarse posteriormente por cualquiera de las partes o por administración.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Principios" sourceRef="Task_DefinirPermisos" targetRef="Annotation_Principios" />
 </bpmn:process>

