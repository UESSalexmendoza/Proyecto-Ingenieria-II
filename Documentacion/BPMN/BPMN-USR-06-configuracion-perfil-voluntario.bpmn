  <bpmndi:BPMNEdge id="F08_di" bpmnElement="Flow_08"><di:waypoint x="1680" y="130"/><di:waypoint x="1730" y="130"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F09_di" bpmnElement="Flow_09"><di:waypoint x="1755" y="155"/><di:waypoint x="1755" y="288"/><di:waypoint x="1830" y="288"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F10_di" bpmnElement="Flow_10"><di:waypoint x="1990" y="288"/><di:waypoint x="2040" y="288"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F11_di" bpmnElement="Flow_11"><di:waypoint x="1780" y="130"/><di:waypoint x="1800" y="130"/><di:waypoint x="1800" y="383"/><di:waypoint x="1830" y="383"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F12_di" bpmnElement="Flow_12"><di:waypoint x="2010" y="383"/><di:waypoint x="2060" y="383"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F13_di" bpmnElement="Flow_13"><di:waypoint x="2085" y="358"/><di:waypoint x="2085" y="168"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F14_di" bpmnElement="Flow_14"><di:waypoint x="2020" y="130"/><di:waypoint x="1920" y="130"/><di:waypoint x="1920" y="345"/></bpmndi:BPMNEdge>
