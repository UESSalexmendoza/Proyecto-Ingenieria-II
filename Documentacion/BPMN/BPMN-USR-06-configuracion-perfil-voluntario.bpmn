  <bpmndi:BPMNEdge id="F22_di" bpmnElement="Flow_22"><di:waypoint x="2900" y="553"/><di:waypoint x="2960" y="553"/><di:waypoint x="2960" y="335"/><di:waypoint x="2990" y="335"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F23_di" bpmnElement="Flow_23"><di:waypoint x="3170" y="335"/><di:waypoint x="3195" y="335"/><di:waypoint x="3195" y="130"/><di:waypoint x="3220" y="130"/></bpmndi:BPMNEdge>
