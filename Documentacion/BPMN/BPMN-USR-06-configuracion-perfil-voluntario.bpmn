  <bpmndi:BPMNShape id="EndBorrador_di" bpmnElement="End_Borrador"><dc:Bounds x="2040" y="270" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Validar_di" bpmnElement="Task_ValidarPerfil"><dc:Bounds x="1830" y="345" width="180" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="GwValido_di" bpmnElement="Gateway_PerfilValido" isMarkerVisible="true"><dc:Bounds x="2060" y="358" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Corregir_di" bpmnElement="Task_CorregirPerfil"><dc:Bounds x="2020" y="92" width="170" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="CrearRevision_di" bpmnElement="Task_CrearRevision"><dc:Bounds x="2170" y="345" width="175" height="76"/></bpmndi:BPMNShape>
