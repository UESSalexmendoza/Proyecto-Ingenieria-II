<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_PerfilVoluntario" targetNamespace="https://barriosolidario.org/bpmn">
 <bpmn:collaboration id="Collaboration_PerfilVoluntario">
  <bpmn:participant id="Participant_PerfilVoluntario" name="Barrio Solidario - Configuración del perfil del voluntario" processRef="Process_PerfilVoluntario" />
 </bpmn:collaboration>
 <bpmn:process id="Process_PerfilVoluntario" name="Configuración, revisión y activación del perfil del voluntario" isExecutable="false">
  <bpmn:laneSet id="LaneSet_PerfilVoluntario">
   <bpmn:lane id="Lane_Voluntario" name="Voluntario">
    <bpmn:flowNodeRef>Start_Configurar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AbrirPerfil</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CompletarDatos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfigurarHabilidades</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ConfigurarCobertura</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfigurarDisponibilidad</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AdjuntarDocumentos</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AccionVoluntario</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_CorregirPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AtenderObservaciones</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_DefinirEstadoDisponibilidad</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Plataforma" name="Plataforma Barrio Solidario">
    <bpmn:flowNodeRef>Task_CargarPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GuardarBorrador</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_Borrador</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarPerfil</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Gateway_PerfilValido</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CrearRevision</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_ActivarPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MantenerInactivo</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_AplicarDisponibilidad</bpmn:flowNodeRef><bpmn:flowNodeRef>End_PerfilActivo</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>End_PerfilRechazado</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Revision" name="Moderación / Coordinación">
    <bpmn:flowNodeRef>Task_RevisarPerfil</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DecisionRevision</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Notificaciones" name="Notificaciones y auditoría">
    <bpmn:flowNodeRef>Task_NotificarPendiente</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotificarObservaciones</bpmn:flowNodeRef>
    <bpmn:flowNodeRef>Task_NotificarResultado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarTrazabilidad</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>

  <bpmn:startEvent id="Start_Configurar" name="Voluntario requiere configurar su perfil" />
  <bpmn:userTask id="Task_AbrirPerfil" name="Abrir Perfil y disponibilidad" />
  <bpmn:serviceTask id="Task_CargarPerfil" name="Cargar datos y estado actual" />
  <bpmn:userTask id="Task_CompletarDatos" name="Completar datos personales y contacto" />
  <bpmn:userTask id="Task_ConfigurarHabilidades" name="Seleccionar habilidades y tipos de asistencia" />
  <bpmn:userTask id="Task_ConfigurarCobertura" name="Definir zona, radio aproximado y movilidad" />
  <bpmn:userTask id="Task_ConfigurarDisponibilidad" name="Configurar días, horarios y restricciones" />
  <bpmn:userTask id="Task_AdjuntarDocumentos" name="Adjuntar requisitos y aceptar políticas" />
  <bpmn:exclusiveGateway id="Gateway_AccionVoluntario" name="¿Guardar o enviar?" />
  <bpmn:serviceTask id="Task_GuardarBorrador" name="Guardar perfil como borrador" />
  <bpmn:endEvent id="End_Borrador" name="Configuración guardada" />
  <bpmn:serviceTask id="Task_ValidarPerfil" name="Validar campos, cobertura, disponibilidad y documentos" />
  <bpmn:exclusiveGateway id="Gateway_PerfilValido" name="¿Perfil completo y válido?" />
  <bpmn:userTask id="Task_CorregirPerfil" name="Corregir campos y requisitos" />
  <bpmn:serviceTask id="Task_CrearRevision" name="Crear revisión con estado pendiente" />
  <bpmn:sendTask id="Task_NotificarPendiente" name="Notificar recepción para revisión" />
  <bpmn:userTask id="Task_RevisarPerfil" name="Revisar identidad, aptitud, documentos y restricciones" />
  <bpmn:exclusiveGateway id="Gateway_DecisionRevision" name="¿Resultado de revisión?" />
  <bpmn:sendTask id="Task_NotificarObservaciones" name="Notificar observaciones" />
  <bpmn:userTask id="Task_AtenderObservaciones" name="Completar información observada" />
  <bpmn:serviceTask id="Task_ActivarPerfil" name="Aprobar y activar perfil de voluntario" />
  <bpmn:serviceTask id="Task_MantenerInactivo" name="Rechazar y mantener perfil no operativo" />
  <bpmn:userTask id="Task_DefinirEstadoDisponibilidad" name="Definir disponible o no disponible" />
  <bpmn:serviceTask id="Task_AplicarDisponibilidad" name="Aplicar disponibilidad y habilitar coincidencias" />
  <bpmn:sendTask id="Task_NotificarResultado" name="Notificar estado y resultado" />
  <bpmn:serviceTask id="Task_RegistrarTrazabilidad" name="Registrar versión, decisión, disponibilidad y responsable" />
  <bpmn:endEvent id="End_PerfilActivo" name="Perfil activo y configurable" />
  <bpmn:endEvent id="End_PerfilRechazado" name="Perfil no habilitado" />

  <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Configurar" targetRef="Task_AbrirPerfil" />
  <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AbrirPerfil" targetRef="Task_CargarPerfil" />
  <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CargarPerfil" targetRef="Task_CompletarDatos" />
  <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CompletarDatos" targetRef="Task_ConfigurarHabilidades" />
  <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ConfigurarHabilidades" targetRef="Task_ConfigurarCobertura" />
  <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ConfigurarCobertura" targetRef="Task_ConfigurarDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConfigurarDisponibilidad" targetRef="Task_AdjuntarDocumentos" />
  <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AdjuntarDocumentos" targetRef="Gateway_AccionVoluntario" />
  <bpmn:sequenceFlow id="Flow_09" name="Guardar borrador" sourceRef="Gateway_AccionVoluntario" targetRef="Task_GuardarBorrador" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_GuardarBorrador" targetRef="End_Borrador" />
  <bpmn:sequenceFlow id="Flow_11" name="Enviar a revisión" sourceRef="Gateway_AccionVoluntario" targetRef="Task_ValidarPerfil" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ValidarPerfil" targetRef="Gateway_PerfilValido" />
  <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_PerfilValido" targetRef="Task_CorregirPerfil" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CorregirPerfil" targetRef="Task_ValidarPerfil" />
  <bpmn:sequenceFlow id="Flow_15" name="Sí" sourceRef="Gateway_PerfilValido" targetRef="Task_CrearRevision" />
  <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CrearRevision" targetRef="Task_NotificarPendiente" />
  <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotificarPendiente" targetRef="Task_RevisarPerfil" />
  <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RevisarPerfil" targetRef="Gateway_DecisionRevision" />
  <bpmn:sequenceFlow id="Flow_19" name="Observado" sourceRef="Gateway_DecisionRevision" targetRef="Task_NotificarObservaciones" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NotificarObservaciones" targetRef="Task_AtenderObservaciones" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_AtenderObservaciones" targetRef="Task_ValidarPerfil" />
  <bpmn:sequenceFlow id="Flow_22" name="Aprobado" sourceRef="Gateway_DecisionRevision" targetRef="Task_ActivarPerfil" />
  <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ActivarPerfil" targetRef="Task_DefinirEstadoDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_DefinirEstadoDisponibilidad" targetRef="Task_AplicarDisponibilidad" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_AplicarDisponibilidad" targetRef="Task_NotificarResultado" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_NotificarResultado" targetRef="Task_RegistrarTrazabilidad" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RegistrarTrazabilidad" targetRef="End_PerfilActivo" />
  <bpmn:sequenceFlow id="Flow_28" name="Rechazado" sourceRef="Gateway_DecisionRevision" targetRef="Task_MantenerInactivo" />
  <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_MantenerInactivo" targetRef="End_PerfilRechazado" />

  <bpmn:textAnnotation id="Annotation_Privacidad"><bpmn:text>La ubicación exacta del voluntario no se publica. Se utiliza zona y radio aproximado para coincidencias. El perfil operativo sólo será visible para funciones autorizadas de coordinación y para solicitudes compatibles. La disponibilidad puede modificarse sin repetir la aprobación, salvo cambios sustanciales del perfil.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Association_Privacidad" sourceRef="Task_ConfigurarCobertura" targetRef="Annotation_Privacidad" />
 </bpmn:process>

 <bpmndi:BPMNDiagram id="Diagram_PerfilVoluntario"><bpmndi:BPMNPlane id="Plane_PerfilVoluntario" bpmnElement="Collaboration_PerfilVoluntario">
  <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_PerfilVoluntario" isHorizontal="true"><dc:Bounds x="30" y="30" width="4240" height="830"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneVol_di" bpmnElement="Lane_Voluntario" isHorizontal="true"><dc:Bounds x="60" y="30" width="4210" height="210"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LanePlat_di" bpmnElement="Lane_Plataforma" isHorizontal="true"><dc:Bounds x="60" y="240" width="4210" height="210"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneRev_di" bpmnElement="Lane_Revision" isHorizontal="true"><dc:Bounds x="60" y="450" width="4210" height="205"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="LaneNotif_di" bpmnElement="Lane_Notificaciones" isHorizontal="true"><dc:Bounds x="60" y="655" width="4210" height="205"/></bpmndi:BPMNShape>
