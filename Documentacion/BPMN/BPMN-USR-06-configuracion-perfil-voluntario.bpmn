  <bpmndi:BPMNEdge id="F27_di" bpmnElement="Flow_27"><di:waypoint x="4090" y="750"/><di:waypoint x="4140" y="750"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F28_di" bpmnElement="Flow_28"><di:waypoint x="2875" y="578"/><di:waypoint x="2875" y="625"/><di:waypoint x="2990" y="625"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F29_di" bpmnElement="Flow_29"><di:waypoint x="3170" y="625"/><di:waypoint x="3220" y="625"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="Assoc_di" bpmnElement="Association_Privacidad"><di:waypoint x="1130" y="168"/><di:waypoint x="1130" y="180"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
