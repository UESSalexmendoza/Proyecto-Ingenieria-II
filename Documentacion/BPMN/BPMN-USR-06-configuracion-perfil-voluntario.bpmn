  <bpmndi:BPMNShape id="Revisar_di" bpmnElement="Task_RevisarPerfil"><dc:Bounds x="2610" y="515" width="190" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="GwDecision_di" bpmnElement="Gateway_DecisionRevision" isMarkerVisible="true"><dc:Bounds x="2850" y="528" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="NotifObs_di" bpmnElement="Task_NotificarObservaciones"><dc:Bounds x="2940" y="715" width="170" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Atender_di" bpmnElement="Task_AtenderObservaciones"><dc:Bounds x="2940" y="92" width="170" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Activar_di" bpmnElement="Task_ActivarPerfil"><dc:Bounds x="2990" y="300" width="180" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Inactivo_di" bpmnElement="Task_MantenerInactivo"><dc:Bounds x="2990" y="600" width="180" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="DefinirDisp_di" bpmnElement="Task_DefinirEstadoDisponibilidad"><dc:Bounds x="3220" y="92" width="180" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="AplicarDisp_di" bpmnElement="Task_AplicarDisponibilidad"><dc:Bounds x="3450" y="300" width="180" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="NotifResult_di" bpmnElement="Task_NotificarResultado"><dc:Bounds x="3680" y="715" width="170" height="70"/></bpmndi:BPMNShape>
