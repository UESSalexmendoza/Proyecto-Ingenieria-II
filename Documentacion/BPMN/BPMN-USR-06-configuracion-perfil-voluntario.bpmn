  <bpmndi:BPMNShape id="Disponibilidad_di" bpmnElement="Task_ConfigurarDisponibilidad"><dc:Bounds x="1270" y="92" width="180" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Documentos_di" bpmnElement="Task_AdjuntarDocumentos"><dc:Bounds x="1500" y="92" width="180" height="76"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="GwAccion_di" bpmnElement="Gateway_AccionVoluntario" isMarkerVisible="true"><dc:Bounds x="1730" y="105" width="50" height="50"/></bpmndi:BPMNShape>
