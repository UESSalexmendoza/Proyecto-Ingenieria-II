@startuml
title Diagrama general de clases UML - Barrio Solidario
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F7FBFF
skinparam classBorderColor #78B7F2
skinparam classFontColor #263238
skinparam classHeaderBackgroundColor #DCEEFF
skinparam ArrowColor #5F6870
skinparam packageBorderColor #5F6870
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontColor #3F454C
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #B0A96E

package "Catálogos y estados" {
class Catalogo

class Rol

class EstadoUsuario

class TipoAyuda

class EstadoSolicitud

class MotivoCancelacion

class EstadoPostulacion

class EstadoAsignacion

class EstadoJornada

class TipoIncidencia

class EstadoIncidencia

class Parentesco

class Prioridad

class TipoEvento
}
package "Identidad y participantes" {
class Usuario

class UsuarioRol <<clase asociativa>>

class Administrador

class Moderador

class Voluntario

class AdultoMayor

class FamiliarCuidador

class RelacionCuidado <<clase asociativa>>

class Ubicacion
}
package "Solicitudes" {
class SolicitudAsistencia

class HistorialSolicitud
}
package "Postulación, asignación y atención" {
class Postulacion

class ResolucionPostulacion

class Asignacion

class Coordinacion

class Jornada

class Mensaje
}
package "Evaluación, comunicación y control" {
class Notificacion

class Calificacion

class Incidencia

class Auditoria
}
Catalogo <|-- Rol
Catalogo <|-- EstadoUsuario
Catalogo <|-- TipoAyuda
Catalogo <|-- EstadoSolicitud
Catalogo <|-- MotivoCancelacion
Catalogo <|-- EstadoPostulacion
Catalogo <|-- EstadoAsignacion
Catalogo <|-- EstadoJornada
Catalogo <|-- TipoIncidencia
Catalogo <|-- EstadoIncidencia
Catalogo <|-- Parentesco
Catalogo <|-- Prioridad
Catalogo <|-- TipoEvento
Usuario <|-- Administrador
Usuario <|-- Moderador
Usuario <|-- Voluntario
Usuario <|-- AdultoMayor
Usuario <|-- FamiliarCuidador

Usuario "1" -- "0..*" UsuarioRol : posee
Rol "1" -- "0..*" UsuarioRol : asigna
EstadoUsuario "1" -- "0..*" Usuario : clasifica
Usuario "1" o-- "0..*" Ubicacion : registra
FamiliarCuidador "1" -- "0..*" RelacionCuidado : mantiene
AdultoMayor "1" -- "0..*" RelacionCuidado : participa
Parentesco "1" -- "0..*" RelacionCuidado : clasifica
AdultoMayor "1" -- "0..*" SolicitudAsistencia : requiere
Usuario "1" -- "0..*" SolicitudAsistencia : registra
TipoAyuda "1" -- "0..*" SolicitudAsistencia : clasifica
Prioridad "1" -- "0..*" SolicitudAsistencia : prioriza
EstadoSolicitud "1" -- "0..*" SolicitudAsistencia : estado
Ubicacion "0..1" -- "0..*" SolicitudAsistencia : localiza
MotivoCancelacion "0..1" -- "0..*" SolicitudAsistencia : justifica
SolicitudAsistencia "1" *-- "1..*" HistorialSolicitud : historial
Usuario "1" -- "0..*" HistorialSolicitud : registra
SolicitudAsistencia "1" -- "0..*" Postulacion : recibe
Voluntario "1" -- "0..*" Postulacion : presenta
EstadoPostulacion "1" -- "0..*" Postulacion : estado
Postulacion "1" *-- "0..1" ResolucionPostulacion : resolución
Usuario "1" -- "0..*" ResolucionPostulacion : resuelve
ResolucionPostulacion "1" -- "0..1" Asignacion : origina
SolicitudAsistencia "1" -- "0..*" Asignacion : mantiene
Voluntario "1" -- "0..*" Asignacion : recibe
EstadoAsignacion "1" -- "0..*" Asignacion : estado
Asignacion "1" *-- "0..*" Coordinacion : coordina
Asignacion "1" *-- "1..*" Jornada : programa
EstadoJornada "1" -- "0..*" Jornada : estado
SolicitudAsistencia "1" -- "0..*" Mensaje : contiene
Jornada "0..1" -- "0..*" Mensaje : contextualiza
Usuario "1" -- "0..*" Mensaje : envía
Usuario "1" -- "0..*" Notificacion : recibe
Jornada "1" -- "0..*" Calificacion : recibe
Usuario "1" -- "0..*" Calificacion : registra
Calificacion "0..*" --> "1" Usuario : evalúa
SolicitudAsistencia "0..1" -- "0..*" Incidencia : genera
Jornada "0..1" -- "0..*" Incidencia : genera
Usuario "1" -- "0..*" Incidencia : reporta
Moderador "0..1" -- "0..*" Incidencia : gestiona
TipoIncidencia "1" -- "0..*" Incidencia : clasifica
EstadoIncidencia "1" -- "0..*" Incidencia : estado
Usuario "0..1" -- "0..*" Auditoria : genera
TipoEvento "1" -- "0..*" Auditoria : clasifica

@enduml
