@startuml
title Catálogos y estados - Barrio Solidario
top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F7FBFF
skinparam classBorderColor #78B7F2
skinparam classFontColor #263238
skinparam classHeaderBackgroundColor #DCEEFF
skinparam ArrowColor #5F6870
skinparam packageBorderColor #5F6870
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontColor #3F454C
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #B0A96E

package "Catálogos y estados" {
abstract class Catalogo {
  + idCatalogo: Integer {readOnly}
  + codigo: String
  + nombre: String
  + descripcion: String
  + activo: Boolean
  + orden: Integer
  --
  + crear(): void
  + actualizar(): void
  + activar(): void
  + desactivar(): void
  + consultar(): Catalogo
  - validarDatosObligatorios(): Boolean
}

class Rol {
  + nivelAcceso: Integer
  --
  + asignarPermiso(): void
  + retirarPermiso(): void
  + contienePermiso(): Boolean
  + consultarPermisos(): List
}

class EstadoUsuario {
  + permiteAcceso(): Boolean
  + permiteReactivacion(): Boolean
  + permiteModificacion(): Boolean
}

class TipoAyuda {
  + estaDisponible(): Boolean
  + requiereUbicacion(): Boolean
}

class EstadoSolicitud {
  + permiteEdicion(): Boolean
  + permitePostulacion(): Boolean
  + permiteCancelacion(): Boolean
  + permiteCierre(): Boolean
}

class MotivoCancelacion {
  + requiereJustificacion(): Boolean
  + aplicaA(): Boolean
}

class EstadoPostulacion {
  + permiteResolucion(): Boolean
  + permiteRetiro(): Boolean
  + esEstadoFinal(): Boolean
}

class EstadoAsignacion {
  + permiteConfirmacion(): Boolean
  + permiteCancelacion(): Boolean
  + permiteJornada(): Boolean
  + esEstadoFinal(): Boolean
}

class EstadoJornada {
  + permiteInicio(): Boolean
  + permiteReprogramacion(): Boolean
  + permiteFinalizacion(): Boolean
  + permiteCalificacion(): Boolean
}

class TipoIncidencia {
  + requiereEscalamiento(): Boolean
  + obtenerNivelInicial(): Integer
}

class EstadoIncidencia {
  + permiteAsignacion(): Boolean
  + permiteResolucion(): Boolean
  + permiteCierre(): Boolean
}

class Parentesco {
  + requiereDocumento(): Boolean
  + permiteRepresentacion(): Boolean
}

class Prioridad {
  + nivel: Integer
  + tiempoObjetivoHoras: Integer
  --
  + compararCon(): Integer
  + requiereAtencionInmediata(): Boolean
}

class TipoEvento {
  + requiereAuditoria(): Boolean
  + requiereDetalleAnterior(): Boolean
}
}
Catalogo <|-- Rol
Catalogo <|-- EstadoUsuario
Catalogo <|-- TipoAyuda
Catalogo <|-- EstadoSolicitud
Catalogo <|-- MotivoCancelacion
Catalogo <|-- EstadoPostulacion
Catalogo <|-- EstadoAsignacion
Catalogo <|-- EstadoJornada
Catalogo <|-- TipoIncidencia
Catalogo <|-- EstadoIncidencia
Catalogo <|-- Parentesco
Catalogo <|-- Prioridad
Catalogo <|-- TipoEvento
@enduml
