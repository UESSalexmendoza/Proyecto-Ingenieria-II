@startuml
title Coordinación y atención - Barrio Solidario
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F7FBFF
skinparam classBorderColor #78B7F2
skinparam classFontColor #263238
skinparam classHeaderBackgroundColor #DCEEFF
skinparam ArrowColor #5F6870
skinparam packageBorderColor #5F6870
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontColor #3F454C
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #B0A96E

package "Coordinación y atención" {
class Asignacion {
  + idAsignacion: Integer {readOnly}
  + fechaAsignacion: DateTime
  + fechaConfirmacion: DateTime
  + fechaFinalizacion: DateTime
  + observaciones: String
  + motivoCancelacion: String
  --
  + crear(): void
  + confirmar(): void
  + rechazar(): void
  + cancelar(): void
  + finalizar(): void
  + reasignar(): Asignacion
  + crearCoordinacion(): Coordinacion
  + programarJornada(): Jornada
  + consultarEstado(): Estado
  - validarAsignacionActiva(): Boolean
}

class Coordinacion {
  + idCoordinacion: Integer {readOnly}
  + fechaPropuesta: Date
  + horarioPropuesto: String
  + fechaConfirmacion: DateTime
  + confirmacionBeneficiario: Boolean
  + confirmacionVoluntario: Boolean
  + observaciones: String
  --
  + proponerFecha(): void
  + confirmarBeneficiario(): void
  + confirmarVoluntario(): void
  + confirmar(): void
  + rechazar(): void
  + reprogramar(): void
  + registrarAcuerdo(): void
  + estaConfirmada(): Boolean
}

class Jornada {
  + idJornada: Integer {readOnly}
  + fecha: Date
  + horaInicioPrevista: DateTime
  + horaFinPrevista: DateTime
  + horaInicioReal: DateTime
  + horaFinReal: DateTime
  + observaciones: String
  + resultado: String
  --
  + programar(): void
  + confirmar(): void
  + iniciar(): void
  + completar(): void
  + reprogramar(): void
  + cancelar(): void
  + registrarObservacion(): void
  + registrarIncidencia(): Incidencia
  + habilitarCalificacion(): void
  + calcularDuracion(): Integer
}

class Mensaje {
  + idMensaje: Integer {readOnly}
  + contenido: String
  + fechaHora: DateTime
  + leido: Boolean
  + fechaLectura: DateTime
  + estadoModeracion: String
  --
  + enviar(): void
  + marcarLeido(): void
  + editar(): void
  + ocultar(): void
  + reportar(): Incidencia
  + consultarConversacion(): List
  - validarContenido(): Boolean
}

class Notificacion {
  + idNotificacion: Integer {readOnly}
  + tipo: String
  + titulo: String
  + mensaje: String
  + fechaCreacion: DateTime
  + fechaEnvio: DateTime
  + fechaLectura: DateTime
  + canal: String
  + estado: String
  --
  + generar(): void
  + enviar(): void
  + marcarLeida(): void
  + reenviar(): void
  + cancelar(): void
  + consultarEstado(): String
  - validarCanal(): Boolean
}

class Calificacion {
  + idCalificacion: Integer {readOnly}
  + puntuacion: Integer
  + comentario: String
  + fechaRegistro: DateTime
  + visible: Boolean
  + estadoModeracion: String
  --
  + registrar(): void
  + actualizar(): void
  + ocultar(): void
  + reportar(): Incidencia
  + consultar(): Calificacion
  - validarPuntuacion(): Boolean
  - validarParticipacion(): Boolean
  - validarJornadaFinalizada(): Boolean
}
}
package "Referencias" {
class SolicitudAsistencia {
  + idSolicitud: Integer {readOnly}
  + titulo: String
  + descripcion: String
  + fechaRequerida: Date
  + horaInicio: DateTime
  + horaFin: DateTime
  + fechaCreacion: DateTime {readOnly}
  + fechaPublicacion: DateTime
  + ubicacionAproximada: String
  + observaciones: String
  --
  + crear(): void
  + actualizar(): void
  + publicar(): void
  + cancelar(): void
  + cambiarEstado(): void
  + consultarDetalle(): Solicitud
  + consultarPostulaciones(): List
  + consultarHistorial(): List
  + agregarMensaje(): void
  + registrarIncidencia(): void
  + cerrar(): void
  - validarDatosObligatorios(): Boolean
  - validarTransicionEstado(): Boolean
}

class Usuario {
  + idUsuario: Integer {readOnly}
  + nombres: String
  + apellidos: String
  + identificacion: String
  + correo: String
  + telefono: String
  + nombreUsuario: String
  + fechaRegistro: DateTime {readOnly}
  + fechaUltimoAcceso: DateTime {readOnly}
  + mfaHabilitado: Boolean
  + aceptacionPoliticas: Boolean
  - contrasenaCifrada: String
  - tokenRecuperacion: String
  - intentosFallidos: Integer
  --
  + registrar(): void
  + autenticar(): Boolean
  + cerrarSesion(): void
  + actualizarPerfil(): void
  + cambiarContrasena(): Boolean
  + solicitarRecuperacion(): void
  + recuperarContrasena(): Boolean
  + activarMFA(): void
  + bloquear(): void
  + desbloquear(): void
  + consultarRoles(): List
  + poseePermiso(): Boolean
  # cambiarEstado(): void
  - validarCredenciales(): Boolean
}

class EstadoJornada {
  + permiteInicio(): Boolean
  + permiteReprogramacion(): Boolean
  + permiteFinalizacion(): Boolean
  + permiteCalificacion(): Boolean
}
}
Asignacion "1" *-- "0..*" Coordinacion : contiene
Asignacion "1" *-- "1..*" Jornada : programa
EstadoJornada "1" -- "0..*" Jornada : estado
SolicitudAsistencia "1" -- "0..*" Mensaje : contiene
Jornada "0..1" -- "0..*" Mensaje : contextualiza
Usuario "1" -- "0..*" Mensaje : envía
Usuario "1" -- "0..*" Notificacion : recibe
Jornada "1" -- "0..*" Calificacion : recibe
Usuario "1" -- "0..*" Calificacion : registra
Calificacion "0..*" --> "1" Usuario : evalúa
@enduml
