@startuml
title Evaluación y control - Barrio Solidario
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F7FBFF
skinparam classBorderColor #78B7F2
skinparam classFontColor #263238
skinparam classHeaderBackgroundColor #DCEEFF
skinparam ArrowColor #5F6870
skinparam packageBorderColor #5F6870
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontColor #3F454C
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #B0A96E

package "Evaluación y control" {
class Incidencia {
  + idIncidencia: Integer {readOnly}
  + titulo: String
  + descripcion: String
  + fechaReporte: DateTime
  + criticidad: String
  + fechaAsignacion: DateTime
  + fechaResolucion: DateTime
  + resolucion: String
  + evidencia: String
  --
  + registrar(): void
  + clasificar(): void
  + cambiarEstado(): void
  + asignarModerador(): void
  + agregarEvidencia(): void
  + escalar(): void
  + resolver(): void
  + cerrar(): void
  + reabrir(): void
  - validarTransicionEstado(): Boolean
}

class Auditoria {
  + idAuditoria: Integer {readOnly}
  + fechaHora: DateTime
  + entidadAfectada: String
  + identificadorEntidad: Integer
  + accion: String
  + valorAnterior: String
  + valorNuevo: String
  + direccionIP: String
  + resultado: String
  + detalle: String
  --
  + registrarEvento(): void
  + consultarPorEntidad(): List
  + consultarPorUsuario(): List
  + consultarPorFecha(): List
  + consultarPorTipo(): List
  + generarReporte(): List
  - validarIntegridad(): Boolean
  - protegerRegistro(): void
}

class Moderador {
  + fechaAsignacion: DateTime
  + nivelModeracion: Integer
  + disponible: Boolean
  --
  + revisarIncidencia(): void
  + asignarseIncidencia(): void
  + aplicarMedida(): void
  + revertirMedida(): void
  + revisarMensaje(): void
  + ocultarContenido(): void
  + escalarIncidencia(): void
  + resolverIncidencia(): void
  + cerrarIncidencia(): void
}

class Usuario {
  + idUsuario: Integer {readOnly}
  + nombres: String
  + apellidos: String
  + identificacion: String
  + correo: String
  + telefono: String
  + nombreUsuario: String
  + fechaRegistro: DateTime {readOnly}
  + fechaUltimoAcceso: DateTime {readOnly}
  + mfaHabilitado: Boolean
  + aceptacionPoliticas: Boolean
  - contrasenaCifrada: String
  - tokenRecuperacion: String
  - intentosFallidos: Integer
  --
  + registrar(): void
  + autenticar(): Boolean
  + cerrarSesion(): void
  + actualizarPerfil(): void
  + cambiarContrasena(): Boolean
  + solicitarRecuperacion(): void
  + recuperarContrasena(): Boolean
  + activarMFA(): void
  + bloquear(): void
  + desbloquear(): void
  + consultarRoles(): List
  + poseePermiso(): Boolean
  # cambiarEstado(): void
  - validarCredenciales(): Boolean
}
}
package "Catálogos y referencias" {
class TipoIncidencia {
  + requiereEscalamiento(): Boolean
  + obtenerNivelInicial(): Integer
}

class EstadoIncidencia {
  + permiteAsignacion(): Boolean
  + permiteResolucion(): Boolean
  + permiteCierre(): Boolean
}

class TipoEvento {
  + requiereAuditoria(): Boolean
  + requiereDetalleAnterior(): Boolean
}

class SolicitudAsistencia {
  + idSolicitud: Integer {readOnly}
  + titulo: String
  + descripcion: String
  + fechaRequerida: Date
  + horaInicio: DateTime
  + horaFin: DateTime
  + fechaCreacion: DateTime {readOnly}
  + fechaPublicacion: DateTime
  + ubicacionAproximada: String
  + observaciones: String
  --
  + crear(): void
  + actualizar(): void
  + publicar(): void
  + cancelar(): void
  + cambiarEstado(): void
  + consultarDetalle(): Solicitud
  + consultarPostulaciones(): List
  + consultarHistorial(): List
  + agregarMensaje(): void
  + registrarIncidencia(): void
  + cerrar(): void
  - validarDatosObligatorios(): Boolean
  - validarTransicionEstado(): Boolean
}

class Jornada {
  + idJornada: Integer {readOnly}
  + fecha: Date
  + horaInicioPrevista: DateTime
  + horaFinPrevista: DateTime
  + horaInicioReal: DateTime
  + horaFinReal: DateTime
  + observaciones: String
  + resultado: String
  --
  + programar(): void
  + confirmar(): void
  + iniciar(): void
  + completar(): void
  + reprogramar(): void
  + cancelar(): void
  + registrarObservacion(): void
  + registrarIncidencia(): Incidencia
  + habilitarCalificacion(): void
  + calcularDuracion(): Integer
}
}
Usuario <|-- Moderador
SolicitudAsistencia "0..1" -- "0..*" Incidencia : genera
Jornada "0..1" -- "0..*" Incidencia : genera
Usuario "1" -- "0..*" Incidencia : reporta
Moderador "0..1" -- "0..*" Incidencia : gestiona
TipoIncidencia "1" -- "0..*" Incidencia : clasifica
EstadoIncidencia "1" -- "0..*" Incidencia : estado
Usuario "0..1" -- "0..*" Auditoria : genera
TipoEvento "1" -- "0..*" Auditoria : clasifica
@enduml
